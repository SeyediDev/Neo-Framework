<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · راهبری هویت و سازمان فن‌آسا</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/access-enhancements.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <a class="brand" asp-page="/Index"><img src="~/fanasa-horizontal-fa.svg" alt="فن‌آسا" width="172" height="60" style="object-fit:contain;background:white;padding:10px;border-radius:10px;width:192px;height:80px" /></a>
        <div class="workspace-label">راهبری هویت و سازمان</div>
        <nav class="nav" aria-label="ناوبری اصلی">
            <a asp-page="/Index">نمای کلی</a>
            <a asp-page="/Centers">۱۴ مرکز قابلیت</a>
            <a asp-page="/Products">کاتالوگ محصولات</a>
            <a asp-page="/Platform">ثبت سامانه و دسترسی توسعه</a>
            <a asp-page="/Tenants">تننت‌ها و سازمان‌ها</a>
            <a asp-page="/Users">کاربران و عضویت‌ها</a>
            <a asp-page="/Roles">نقش‌ها و مجوزها</a>
            <a asp-page="/Organization">استودیو ساختار سازمانی</a>
            <a asp-page="/Tenancy">عضویت و اشتراک SaaS</a>
            <a asp-page="/Governance">گردش هویت و الگوهای دسترسی</a>
            <a asp-page="/Billing">مصرف و پرداخت</a>
            <a asp-page="/Accounting">اکانتینگ و صورتحساب</a>
            <a asp-page="/Audit">گزارش رویدادها</a>
        </nav>
        <div class="sidebar-footer"><span class="status-dot"></span> هویت مرکزی فعال</div>
    </aside>
    <main class="shell">
        <header class="topbar">
            <div><span class="eyebrow">Fanasa Identity &amp; Organization Governance</span><h1>@ViewData["Title"]</h1></div>
            <div class="user-menu"><span>@(User.Identity?.Name ?? User.FindFirst("preferred_username")?.Value ?? "کاربر سازمانی")</span><a href="/logout">خروج</a></div>
        </header>
        <section class="content">@RenderBody()</section>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · مدیریت دسترسی فن‌آسا</title><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"/></head><body><aside class="sidebar"><a class="brand" asp-page="/Index"><span class="brand-mark">ف</span><span>فن‌آسا</span></a><div class="workspace-label">مرکز دسترسی سازمانی</div><nav class="nav"><a asp-page="/Index">نمای کلی</a><a asp-page="/Tenants">تننت‌ها و سازمان‌ها</a><a asp-page="/Users">کاربران و عضویت‌ها</a><a asp-page="/Roles">نقش‌ها و مجوزها</a><a asp-page="/Audit">گزارش رویدادها</a></nav><div class="sidebar-footer"><span class="status-dot"></span> هویت مرکزی فعال</div></aside><main class="shell"><header class="topbar"><div><span class="eyebrow">Fanasa Access Management</span><h1>@ViewData["Title"]</h1></div><div class="user-menu"><span>@(User.Identity?.Name ?? User.FindFirst("preferred_username")?.Value ?? "کاربر سازمانی")</span><a href="/logout">خروج</a></div></header><section class="content">@RenderBody()</section></main>@await RenderSectionAsync("Scripts", required: false)</body></html>

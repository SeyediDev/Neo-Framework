@page
@model Fanasa.AccessManagement.Web.Pages.GovernanceModel
@{ ViewData["Title"] = "سیاست و تصمیم دسترسی"; }
<link rel="stylesheet" href="~/css/organization.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/governance.css" asp-append-version="true" />
<section class="org-hero governance-hero"><div><span class="eyebrow">XACML · سیاست و تصمیم دسترسی</span><h2>چه کسی، در کدام سازمان، چه کاری و چه زمانی می‌تواند انجام دهد؟</h2><p>مثلاً «ویرایش چارت فقط در ساعات کاری و روز غیرتعطیل». تقویم را در پنل سازمان تعریف کنید، محدودیت را به عملیات وصل کنید، تصمیم را آزمایش و با بررسی مستقل منتشر کنید.</p></div><span class="pill amber">اجرای زنده وابسته به فعال‌بودن سازمان<br />و عملیات پشتیبانی‌شده در سرور</span></section>
@if(Model.SelectedTenant.HasValue){<nav class="governance-flow" aria-label="مسیر سیاست تا اجرای درخواست"><ol>
<li><a href="#policy-authoring"><b>۱ · PAP</b><span>قاعده را بنویسید</span></a></li><li><a href="#policy-catalog"><b>۲ · مخزن سیاست</b><span>مستقل منتشر کنید</span></a></li><li><a href="#attribute-sources"><b>۳ · PIP</b><span>اطلاعات معتبر را بخوانید</span></a></li><li><a href="#decision-workbench"><b>۴ · درخواست</b><span>هویت، منبع، عمل و زمان</span></a></li><li><a href="#access-decision"><b>۵ · PDP</b><span>تصمیم و علت را دریافت کنید</span></a></li><li><a href="#enforcement-boundary"><b>۶ · PEP</b><span>تعهدها و عملیات</span></a></li>
</ol></nav>}
@if(!Model.SelectedTenant.HasValue){<section class="panel empty-state"><h2>سازمان مجاز برای نمایش وجود ندارد</h2><p>مجوز مشاهده عضویت و چارت هر دو لازم‌اند.</p></section>}
else {
<div id="governance-app" data-tenant="@Model.SelectedTenant" data-subject="@Model.Subject" data-admin="@Model.IsAdmin.ToString().ToLowerInvariant()" data-review="@Model.CanReview.ToString().ToLowerInvariant()" data-template="@Model.IsTemplateTenant.ToString().ToLowerInvariant()">
@Html.AntiForgeryToken()
<div class="org-toolbar"><form method="get"><label>سازمان <select name="tenant">@foreach(var tenant in Model.Tenants){<option value="@tenant.Id" selected="@(tenant.Id == Model.SelectedTenant)">@tenant.DisplayName</option>}</select></label><button class="button secondary">نمایش</button></form><button class="button secondary" id="governance-refresh">تازه‌سازی</button></div>
<p id="governance-message" role="status" aria-live="polite"></p><p id="governance-chart-restricted" class="governance-note" hidden>چارت سازمان در زمان فعلی توسط کنترل زمانی محدود شده است؛ اطلاعات سمت و انتصاب در این نما عمداً خالی است. مجوز مستقیم، زمان دسترسی را دور نمی‌زند. دلیل تصمیم را با آزمایش درخواست بررسی کنید.</p>
@if(Model.IsAdmin){<p class="governance-note"><a class="button secondary" href="/PolicyWorkbench">کارگاه قرارداد و اجرای تعهدها</a> پروفایل نوع‌دار قرارداد را در آزمایشگاه مستقلِ سرور بررسی کنید: تصمیم، پذیرش مصرف، تعهدها و عملیات آزمایشی. این مسیر با قواعد نقش و زمان این صفحه فرق دارد و دسترسی زندهٔ سازمان را فعال نمی‌کند.</p>}
<section class="panel governance-profile"><h3>پروفایل قابل اجرا در این سازمان</h3><p>قالب‌های «نقش و انتصاب فعال»، «عضویت و بازهٔ زمانی»، «محدودیت اجباری زمان» و «ویژگی معتبر از منبع PIP» پشتیبانی می‌شوند. هر قاعده یک عملیات را در همین سازمان هدف می‌گیرد. قاعدهٔ منتشرشده با گزینهٔ اجرای زنده، فقط در سازمان فعال‌شده و عملیات پشتیبانی‌شدهٔ سرور، مجوز موجود را محدود می‌کند؛ پیش‌نویس فقط با انتخاب صریح در آزمایش مدیر قابل بررسی است.</p><dl id="policy-state" class="governance-facts"></dl><details><summary>چند اجازه، منع و خطای مرجع چگونه ترکیب می‌شوند؟</summary><p><b dir="ltr">deny-overrides</b>: منع صریح بر اجازه مقدم است. محدودیت اجباری زمان، خارج از پنجره حتی مجوز مستقیم را رد می‌کند. تقویم نامعتبر، غیرفعال یا خارج پوشش اجازهٔ عبور از محدودیت زمانی نمی‌دهد. در شرط ویژگی، منبع غیرفعال، دادهٔ منقضی یا ویژگی لازمِ مفقود نتیجهٔ نامعین می‌دهد؛ این نقص با مجوز مستقیم دور زده نمی‌شود. عضو غیرفعال رد می‌شود؛ نبود قاعده و مجوز قابل اعمال، <b dir="ltr">NotApplicable</b> است.</p><p>ترکیب‌های دلخواه PolicySet، عبارت‌های عمومی و واردکردن XML در این پروفایل پشتیبانی نمی‌شوند.</p></details></section>
<section class="panel org-editor" id="identity-lifecycle" hidden="@Model.IsTemplateTenant"><span class="eyebrow">JOINER · MOVER · LEAVER</span><h3>تغییر مسئولیت، دادهٔ تصمیم را از کجا تغییر می‌دهد؟</h3><p>ورود، جابه‌جایی و خروج بر عضویت و انتصاب اثر می‌گذارند؛ همین اطلاعات شرط قواعد دسترسی‌اند. این گردش، درخواست و بررسی مستقل را ثبت می‌کند. اجرای تغییر هنوز فعال نیست؛ تأیید به‌تنهایی دادهٔ PIP یا مجوز را تغییر نمی‌دهد.</p><form id="lifecycle-form">
<label>نوع درخواست <select name="operation"><option value="join">ورود عضو</option><option value="move">جابه‌جایی عضو</option><option value="leave">خروج عضو</option></select></label>
<label>شناسه هویت مرکزی <input name="subject" required maxlength="200" /></label><label>نام نمایشی برای ورود <input name="displayName" maxlength="200" /></label>
<label>سمت جدید <select name="positionId"></select></label><label>انتصاب قبلی برای جابه‌جایی <select name="previousAppointmentId"></select></label>
<label>زمان مؤثر <input name="effectiveAt" type="datetime-local" required /></label><label>پایان انتصاب جدید <input name="endsAt" type="datetime-local" /></label>
<label class="org-reason">دلیل <input name="reason" maxlength="1000" required /></label><button class="button primary" type="submit">ثبت درخواست</button>
</form></section>
<section class="panel org-history" id="lifecycle-history" hidden="@Model.IsTemplateTenant"><h3>درخواست‌ها و بررسی</h3><p class="muted">۱۰۰ درخواست اخیر؛ نسخه و وضعیت هر درخواست برای جلوگیری از بررسی هم‌زمان کنترل می‌شود.</p><div id="lifecycle-requests"></div></section>
@if(Model.IsAdmin && !Model.IsTemplateTenant){
<section id="policy-authoring" class="panel org-editor governance-stage"><span class="eyebrow">۱ · PAP · مدیریت سیاست</span><h3>هدف و شرط یک اجازه یا منع را تعریف کنید</h3><p>ورودی: عملیات، اثر، شرط نقش یا عضویت و زمان. خروجی: پیش‌نویس با شناسهٔ مستقل. پیش‌نویس اجازه‌ای نمی‌دهد؛ مدیر دیگری باید آن را منتشر کند.</p><p id="pattern-copy-origin" class="governance-note" hidden></p><form id="pattern-form">
<label>نام الگو <input name="name" required maxlength="200" /></label><label>الگو <select name="template"><option value="role">نقش سازمانی و انتصاب فعال</option><option value="member-window">عضویت فعال و پنجره زمانی</option><option value="time-guard">محدودیت اجباری زمان برای همهٔ مجوزها</option><option value="attribute">ویژگی معتبر از منبع اطلاعات PIP</option></select></label>
<label>عملیات مجاز / ممنوع <select name="permission"></select></label><label>اثر <select name="effect"><option>Permit</option><option>Deny</option></select></label>
<label>نقش لازم <select name="roleId" required></select></label><label>واحدِ انتصاب <select name="unitId"></select></label>
<label hidden>منبع معتبر ویژگی <select name="pipSourceId" disabled></select></label><label hidden>ویژگی تعریف‌شده <select name="attributeName" disabled></select></label><label hidden>مقدار برابر با <input name="attributeValue" disabled maxlength="1000" dir="ltr" placeholder="true" /></label><p class="org-reason governance-note" id="pattern-pip-note" hidden>مثال: منبع منابع انسانی، ویژگی employment.active، مقدار true. منبع و قرارداد را در <a href="/Organization?tenant=@Model.SelectedTenant#organization-pip">اطلاعات سازمان</a> تعریف و دادهٔ همان هویت را دریافت کنید. داده باید تازه و مطابق قرارداد باشد؛ دادهٔ مفقود، منقضی یا نامعتبر، حتی با مجوز مستقیم، تصمیم را نامعین می‌کند. مقدار نابرابر یعنی این قاعده تطبیق ندارد؛ برای الزام «فقط کارکنان فعال»، سیاست منع مناسب هم لازم است. این شرط ویژگی را از فرم درخواست قبول نمی‌کند.</p>
<label>مرجع تقویم / پنجرهٔ داده <select name="calendarId"></select></label><label>شرط تقویم <select name="calendarMode"><option value="working-time">فقط داخل ساعت و روز کاری / پنجره</option><option value="non-holiday">فقط روز کاری؛ ساعت آزاد</option></select></label><p class="org-reason governance-note">دادهٔ روز کاری، تعطیلی و پنجره‌های زمانی را در <a href="/Organization?tenant=@Model.SelectedTenant#organization-calendars">پنل همین سازمان</a> نگه دارید. «محدودیت اجباری زمان» بیرون از تقویم، مجوز مستقیم را هم متوقف می‌کند و داخل تقویم خودش مجوزی نمی‌دهد. در قالب‌های دیگر، تقویم فقط شرط همان قاعده است.</p>
<label>اعتبار از <input name="startsAt" type="datetime-local" /></label><label>اعتبار تا <input name="endsAt" type="datetime-local" /></label>
<label>ساعت شروع روزانه UTC <input name="utcStartHour" type="number" min="0" max="23" /></label><label>ساعت پایان روزانه UTC <input name="utcEndHour" type="number" min="0" max="24" /></label>
<label class="org-reason governance-check"><input name="enforce" type="checkbox" checked /> پس از انتشار مستقل، برای اعمال در مسیر واقعی انتخاب شود</label><label class="org-reason">دلیل تعریف <input name="reason" required maxlength="1000" /></label><div id="pattern-preview" class="org-reason governance-note" aria-live="polite"></div><p class="org-reason muted">زمان‌های اعتبار به وقت محلی وارد و به UTC ارسال می‌شوند. ساعت روزانهٔ قدیمی UTC است؛ برای ساعت کاری و تعطیلات، مرجع تقویم انتخاب کنید. قالب عضویت به حداقل یک شرط زمانی نیاز دارد. قواعد قدیمی بدون گزینهٔ اجرای زنده، به‌صورت خودکار فعال نمی‌شوند.</p><button class="button primary" type="submit">ذخیره پیش‌نویس برای بررسی مستقل</button>
</form></section>}
@if(!Model.IsAdmin || Model.IsTemplateTenant){<section id="policy-authoring" class="panel governance-stage"><span class="eyebrow">۱ · PAP · مدیریت سیاست</span><h3>@(Model.IsTemplateTenant ? "سیاست‌های الگو برای یادگیری و آزمایش‌اند" : "تعریف قاعده به مدیر پلتفرم نیاز دارد")</h3><p>@(Model.IsTemplateTenant ? "این نمای آموزشی فقط‌خواندنی است. برای بررسی قواعد نمونه، در فرم آزمایش گزینهٔ احتساب پیش‌نویس‌ها را انتخاب کنید؛ انتشار، بازنشستگی و تغییر اعضا در این نما انجام نمی‌شود." : "مدیر قاعده را به پیش‌نویس تبدیل می‌کند و مدیر دیگری آن را منتشر می‌کند. شما می‌توانید قواعد منتشرشده و تصمیم درخواست خود را بررسی کنید.")</p></section>}
<section id="policy-catalog" class="panel org-history governance-stage"><span class="eyebrow">۲ · مخزن سیاست · انتشار و نسخه</span><h3>کدام قواعد واقعاً وارد تصمیم می‌شوند؟</h3><p>پیش‌نویس ← انتشار توسط مدیر دوم ← قابل ارزیابی ← بازنشستگی. متن قاعدهٔ منتشرشده تغییر نمی‌کند؛ برای اصلاح، پیش‌نویس تازه بسازید. هر تغییر، بازبینی مخزن را افزایش می‌دهد و با بازبینی مشاهده‌شده کنترل می‌شود. بازهٔ اعتبار و انتصاب شامل شروع و غیرشامل پایان است.</p><div class="governance-catalog-filters"><label>وضعیت <select id="policy-status"><option value="all">همه وضعیت‌ها</option><option value="published">منتشرشده</option><option value="draft">پیش‌نویس</option><option value="retired">بازنشسته</option></select></label><label>جست‌وجوی نام، عملیات یا شناسه <input id="policy-search" type="search" /></label><span id="policy-count" role="status"></span></div><div id="access-patterns"></div></section>
<section id="attribute-sources" class="panel governance-stage"><span class="eyebrow">۳ · PIP · مرجع اطلاعات</span><h3>اجازه بر پایهٔ دادهٔ ثبت‌شده صادر می‌شود</h3><p>موتور عضویت را از مخزن اعضای سازمان و نقش، واحد و انتصاب را از چارت ثبت‌شده می‌خواند. ویژگی‌های خارجی از منبع مشخص و دادهٔ معتبرِ همان هویت در همین سازمان خوانده می‌شوند. فرم درخواست فقط شناسهٔ فرد، عملیات و زمان آزمایش را می‌فرستد؛ ادعای «من این نقش را دارم» ورودی معتبر این موتور نیست.</p><div id="attribute-summary" class="governance-source-grid"></div><p id="attribute-freshness" class="muted"></p><p class="governance-note">مجوز مستقیمِ معتبر نیز در موتور بررسی می‌شود؛ پاسخ این صفحه جزئیات آن مجوزها را برنمی‌گرداند. <a href="/Tenancy">مدیریت اعضا و مجوزها</a> · <a href="/Organization?tenant=@Model.SelectedTenant#organization-calendars">مدیریت چارت، انتصاب و تقویم</a> · <a href="/Organization?tenant=@Model.SelectedTenant#organization-pip">مدیریت منبع خارجی، قرارداد، دریافت و تازگی داده</a></p></section>
<section id="decision-workbench" class="panel org-editor governance-stage"><span class="eyebrow">۴–۵ · درخواست و PDP · نقطهٔ تصمیم</span><h3>یک درخواست مشخص را به موتور بدهید</h3><p>آیا این هویت می‌تواند این عملیات را در سازمان انتخاب‌شده، در این زمان انجام دهد؟ موتور قواعد منتشرشده و مجوزهای مستقیم را ترکیب می‌کند و تصمیم، علت، شناسهٔ قواعد مؤثر، تعهدها و توصیه‌ها را برمی‌گرداند.</p><form id="decision-form"><label>Subject · شناسه هویت مرکزی <input name="subject" value="@Model.Subject" readonly="@(!Model.IsAdmin)" list="governance-members" required maxlength="200" /></label><label>Action · عملیات <select name="permission"></select></label><label>Environment · زمان محلی آزمایش <input name="at" type="datetime-local" /></label><p class="org-reason muted">Resource همان سازمان انتخاب‌شده است. زمان خالی یعنی ساعت فعلی سرور. اطلاعات زیر نمای خوانده‌شده از مخزن است؛ پاسخ تصمیم از ارزیابی تازهٔ سرور می‌آید.</p>@if(Model.IsAdmin){<label class="org-reason governance-check"><input name="includeDrafts" type="checkbox" /> پیش‌نویس‌ها هم فقط در این آزمایش بررسی شوند</label>}<button class="button primary" type="submit">ارزیابی این درخواست</button></form><datalist id="governance-members"></datalist><div id="request-context" class="governance-context"></div><div id="access-decision" role="status" aria-live="polite"><p class="governance-note">درخواست را ارزیابی کنید تا تصمیم، علت و اقدام بعدی را ببینید.</p></div><details class="governance-decision-key"><summary>چهار پاسخ چه تفاوتی دارند؟</summary><dl><dt dir="ltr">Permit</dt><dd>اجازهٔ سیاست؛ اجرای عملیات به کنترل‌های API و انجام تعهدهای اجباری وابسته است.</dd><dt dir="ltr">Deny</dt><dd>درخواست رد شده؛ عضویت غیرفعال یا منع قابل اعمال را بررسی کنید.</dd><dt dir="ltr">NotApplicable</dt><dd>قاعده یا مجوز قابل اعمالی پیدا نشده است؛ این پاسخ اجازهٔ اجرا نیست.</dd><dt dir="ltr">Indeterminate</dt><dd>اطلاعات لازم برای تصمیم معتبر کافی نیست؛ مرجع نقش، واحد یا تقویم را اصلاح و دوباره ارزیابی کنید.</dd></dl></details></section>
<section id="enforcement-boundary" class="panel governance-stage governance-enforcement"><span class="eyebrow">۶ · PEP · نقطهٔ اعمال تصمیم</span><h3>آزمایش، انتشار و اجرای واقعی سه مرحله‌اند</h3><p>در سازمانی که کنترل زمانی در سرور برایش فعال شده، قواعد منتشرشده با گزینهٔ اجرای زنده، مجوز موجودِ خواندن و نوشتن چارت و مسیر HR را محدود می‌کنند. این اتصال مجوز تازه یا claim ایجاد نمی‌کند؛ سایر عملیات فعلاً فقط در شبیه‌سازی این صفحه بررسی می‌شوند. دادهٔ تقویم از مخزن همان سازمان و زمان از سرور خوانده می‌شود. شکست تعهد اجباری باید اجرا را متوقف کند.</p><p class="governance-note"><b>حسابرسی و HR3:</b> API سازمان و HR قدیمی، ثبت حسابرسی سیاست را در مسیر اجرا انجام می‌دهند. آداپتور فقط‌خواندنی HR3 توان انجام تعهد <code>audit</code> را ندارد؛ اگر قاعدهٔ تقویمیِ فعال و منتشرشده، <code>Permit</code> همراه با این تعهد برگرداند، درخواست HR3 حتی داخل ساعت مجاز رد می‌شود. پشتیبانی از آن به اتصال جداگانهٔ اجرای تعهد نیاز دارد.</p><p class="governance-note"><b>این کارگاه:</b> پاسخ آزمایش همواره <code>enforced: false</code> است؛ این دکمه هیچ عملیات یا مجوزی اعمال نمی‌کند. پیش‌نویس‌های آموزشی منتشر نمی‌شوند؛ فعال‌شدن زنده به گزینهٔ اجرای زنده، انتشار مستقل، فعال‌بودن سازمان در تنظیمات سرور و پشتیبانی عملیات نیاز دارد. Permit آزمایش، نتیجهٔ اجرای API نیست. وضعیت قابلیت اتصال سرور و تعداد قواعد فعال در بالای صفحه نمایش داده می‌شود.</p><a class="button secondary" href="#decision-workbench">بازگشت به آزمایش درخواست</a></section>
<p class="muted">این پیاده‌سازی یک پروفایل محدود مبتنی بر مفاهیم XACML است؛ مفسر عمومی XML یا ادعای انطباق کامل استاندارد نیست. <a href="https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html" target="_blank" rel="noopener">مشخصات رسمی OASIS</a></p>
</div>}

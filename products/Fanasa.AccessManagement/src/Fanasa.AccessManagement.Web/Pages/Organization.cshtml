@page
@model Fanasa.AccessManagement.Web.Pages.OrganizationModel
@{ ViewData["Title"] = "استودیو ساختار سازمانی"; }
<link rel="stylesheet" href="~/css/organization.css" asp-append-version="true" />
<section class="org-hero"><div><span class="eyebrow">ORGANIZATION FABRIC</span><h2>ساختار روشن، مسئولیت مشخص</h2><p>واحدها، سمت‌ها و انتصاب‌ها را در یک نمای زنده مدیریت کنید.</p></div><span class="pill teal">سرویس سازمانی چندمستاجری</span></section>
@if(User.Identity?.IsAuthenticated == true && User.HasClaim("permission", "platform.admin")){
<section class="panel org-template-panel" id="organization-template"><span class="eyebrow">یادگیری با دادهٔ ثبت‌شده</span><h3>سازمان الگو؛ از دادهٔ سازمان تا علت تصمیم</h3><p>یک سازمان آموزشی شامل ساختار، اعضای مصنوعی، تقویم کاری، شیفت شب، تعطیلی، پنجرهٔ داده و سیاست‌های پیش‌نویس. سناریوها با موتور سرور اجرا می‌شوند و نتیجهٔ مورد انتظار با نتیجهٔ واقعی مقایسه می‌شود.</p>@Html.AntiForgeryToken()
<p id="org-template-message" role="status" aria-live="polite"></p><div id="org-template-links" class="org-calendar-actions"></div><form id="org-template-create" class="org-template-actions" hidden><label>دلیل ایجاد دادهٔ آموزشی <input name="reason" maxlength="1000" required value="ایجاد سازمان الگو برای یادگیری تنظیمات و سیاست‌های زمانی" /></label><button class="button primary" type="submit">ساخت سازمان الگو در پایگاه داده</button></form><details class="org-template-guide"><summary>راهنمای تنظیمات و درس‌های سازمان الگو</summary><div id="org-template-notes"></div><div id="org-template-lessons" class="org-template-lessons"></div></details><button class="button secondary" type="button" id="org-template-run" hidden>اجرای همهٔ سناریوهای آموزشی</button><div id="org-template-results" role="status" aria-live="polite"></div></section>
}
@if (!Model.SelectedTenant.HasValue)
{
    <section class="panel empty-state"><h2>سازمان مجاز برای نمایش وجود ندارد</h2><p>دسترسی خواندن ساختار سازمانی باید برای سازمان شما ثبت شود.</p></section>
}
else
{
<div id="organization-app" data-tenant="@Model.SelectedTenant" data-write="@Model.CanWrite.ToString().ToLowerInvariant()" data-template="@Model.IsTemplateTenant.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <div class="org-toolbar"><form method="get"><label>سازمان <select name="tenant" onchange="this.form.submit()">@foreach(var tenant in Model.Tenants){<option value="@tenant.Id" selected="@(tenant.Id == Model.SelectedTenant)">@tenant.DisplayName</option>}</select></label></form><label>جست‌وجو <input id="org-search" type="search" placeholder="نام یا کد واحد" /></label><button class="button secondary" id="org-refresh">بارگذاری مجدد</button><span id="org-revision" class="pill blue"></span></div>
    <p id="org-message" role="status" aria-live="polite"></p>
    <div class="metrics" id="org-metrics"></div>
    <div class="org-workspace"><section class="panel org-chart-panel"><div class="panel-heading"><h3>نقشه سازمان</h3><div><button class="button secondary" id="zoom-out" aria-label="کوچک‌نمایی">−</button><button class="button secondary" id="zoom-reset">۱۰۰٪</button><button class="button secondary" id="zoom-in" aria-label="بزرگ‌نمایی">+</button></div></div><div class="org-viewport"><div id="org-tree" role="tree" aria-label="چارت سازمانی"></div></div></section><aside class="panel" id="org-detail"><h3>جزئیات واحد</h3><p class="muted">یک واحد را روی نمودار انتخاب کنید.</p></aside></div>
    <section class="panel org-calendar-section" id="organization-calendars"><span class="eyebrow">دادهٔ مرجع سازمان · تقویم و پنجرهٔ داده</span><h3>روز کاری و زمان قابل استفاده را یک‌بار تعریف کنید</h3><p>این بخش ساعت کاری، روزهای تعطیل و پنجره‌های زمانی دادهٔ همین سازمان را نگه می‌دارد. سیاست دسترسی در <a href="/Governance?tenant=@Model.SelectedTenant#policy-authoring">بخش سیاست و دسترسی</a> به این داده ارجاع می‌دهد. تعریف تقویم به‌تنهایی به کسی مجوز نمی‌دهد.</p>
    <ol class="org-calendar-guide"><li><b>۱ · مرجع زمان</b><span>منطقهٔ زمانی و بازه‌ای را که تقویم آن بررسی شده ثبت کنید.</span></li><li><b>۲ · هفته و استثنا</b><span>ساعت‌های هفتگی را وارد کنید؛ تعطیلی یا روز کاری استثنایی، برنامهٔ آن تاریخ را جایگزین می‌کند.</span></li><li><b>۳ · آزمایش و استفاده</b><span>یک زمان را با تقویم ذخیره‌شده آزمایش کنید و سپس آن را در شرط سیاست انتخاب کنید.</span></li></ol>
    <p id="org-calendar-message" role="status" aria-live="polite"></p><div class="panel-heading"><h4>تقویم‌های ذخیره‌شده</h4><span class="pill blue" id="org-calendar-revision"></span></div><div id="org-calendar-list" class="org-calendar-list"></div>
    @if(Model.CanManageCalendars){<details id="org-calendar-editor" class="org-calendar-editor"><summary>تعریف یا ویرایش تقویم و پنجرهٔ داده</summary><form id="org-calendar-form" class="org-calendar-form">
    <input name="id" type="hidden" /><label>کد ثابت <input name="code" required maxlength="80" placeholder="office-hours" dir="ltr" /></label><label>نام روشن <input name="name" required maxlength="200" placeholder="ساعات کاری دفتر مرکزی" /></label><label>نوع داده <select name="kind"><option value="work">تقویم کاری و تعطیلی سازمان</option><option value="data">پنجرهٔ زمانی دسترسی به داده</option></select></label>
    <label>منطقهٔ زمانی IANA <input name="timeZoneId" required maxlength="100" value="Asia/Tehran" list="org-time-zones" dir="ltr" /></label><datalist id="org-time-zones"><option value="Asia/Tehran"></option><option value="UTC"></option><option value="Europe/Berlin"></option></datalist><label>تقویم بررسی‌شده از تاریخ <input name="coverageFrom" type="date" required /></label><label>تا تاریخ، شامل این روز <input name="coverageThrough" type="date" required /></label>
    <p class="org-reason org-calendar-note">تاریخ‌ها میلادی و ساعت‌ها به وقت منطقهٔ زمانی همین تقویم‌اند. بیرون از بازهٔ بررسی‌شده، موتور نمی‌تواند بازبودن زمان را تأیید کند. تعطیلات رسمی از اینترنت حدس زده نمی‌شوند؛ تاریخ و مرجع مصوب را ثبت کنید.</p>
    <fieldset class="org-reason"><legend>برنامهٔ هفتگی</legend><p class="muted">برای یک روز می‌توانید چند بازه بگذارید. روز بدون بازه، غیرکاری است. شروع بزرگ‌تر از پایان یعنی شیفت شب؛ تعطیلی روز بعد ادامهٔ شیفت را قطع می‌کند. پایان 24:00 مجاز است.</p><div id="org-weekly-windows"></div><div class="org-calendar-actions"><button type="button" class="button secondary" id="org-weekly-add">افزودن بازه</button><button type="button" class="button secondary" id="org-weekly-example">پرکردن هفتهٔ نمونه: شنبه تا چهارشنبه، ۸ تا ۱۶</button></div></fieldset>
    <fieldset class="org-reason"><legend>تعطیلی و استثنای تاریخ‌دار</legend><p class="muted">«تعطیل» تمام روز را می‌بندد؛ «باز با ساعت مشخص» فقط بازه‌های واردشده را باز می‌کند. مثال بازه‌ها: <bdi>08:00-12:00, 13:00-16:00</bdi>. هر تاریخ باید در بازهٔ بررسی‌شده باشد.</p><div id="org-date-exceptions"></div><button type="button" class="button secondary" id="org-exception-add">افزودن تعطیلی یا استثنا</button></fieldset>
    <label class="org-reason">مرجع اطلاعات تقویم <input name="source" required maxlength="500" placeholder="مثلاً بخشنامهٔ ساعات کاری شماره ... و فهرست تعطیلی‌های تأییدشده" /></label><label class="org-calendar-check"><input name="active" type="checkbox" checked /> تقویم فعال است</label><label class="org-reason">دلیل ثبت یا تغییر <input name="reason" required maxlength="1000" /></label><div class="org-reason org-calendar-actions"><button class="button primary" type="submit">ذخیرهٔ تقویم سازمان</button><button class="button secondary" type="button" id="org-calendar-new">شروع تقویم تازه</button></div>
    </form></details>}
    <div class="org-calendar-probe"><h4>این زمان طبق دادهٔ ذخیره‌شده باز است؟</h4><form id="org-calendar-evaluate" class="org-calendar-form"><label>تقویم / پنجره <select name="calendarId" required></select></label><label>شرط مورد بررسی <select name="mode"><option value="working-time">داخل ساعت و روز کاری / پنجرهٔ داده</option><option value="non-holiday">روز کاری، بدون محدودیت ساعت</option></select></label><label>زمان آزمایش <input name="at" type="datetime-local" required /></label><p class="org-reason muted" id="org-calendar-clock"></p><button class="button secondary" type="submit">بررسی با دادهٔ سرور</button></form><div id="org-calendar-result" role="status" aria-live="polite"></div></div>
    </section>
    @if(Model.CanReadPip){
    <section class="panel org-calendar-section" id="organization-pip" data-manage="@Model.CanManagePip.ToString().ToLowerInvariant()">
    <span class="eyebrow">PIP · دادهٔ معتبر از سامانهٔ مرجع</span><h3>موتور از کجا بفهمد همکاری یک فرد هنوز فعال است؟</h3>
    <p>منبع اطلاعات سیاست، ویژگی‌هایی مانند وضعیت همکاری و واحد سازمانی را از سامانهٔ مسئول آن دریافت و در همین سازمان ثبت می‌کند. سیاست در <a href="/Governance?tenant=@Model.SelectedTenant#policy-authoring">بخش سیاست و دسترسی</a> به منبع و ویژگی مشخص ارجاع می‌دهد. ثبت منبع یا دریافت داده به‌تنهایی مجوز نمی‌سازد.</p>
    <ol class="org-calendar-guide"><li><b>۱ · مسئول داده و قرارداد</b><span>نشانی HTTPS تأییدشده، نام ویژگی‌ها، نوع و نگاشت فیلدهای سامانهٔ مرجع را مشخص کنید. رمز در سرور نگه داشته می‌شود؛ اینجا فقط نام مرجع آن را وارد کنید.</span></li><li><b>۲ · دریافت و کنترل</b><span>منبع ابتدا غیرفعال ثبت می‌شود. پس از فعال‌سازی، دادهٔ یک هویت مشخص را دریافت کنید؛ سازمان، هویت، نسخه، نوع و زمان مشاهده در سرور کنترل می‌شوند.</span></li><li><b>۳ · قاعده و آزمایش</b><span>مثلاً employment.active برابر true. پیش‌نویس را آزمایش کنید. نبود دادهٔ تازه یا ویژگی لازم، نتیجهٔ نامعین می‌دهد؛ دادهٔ موفق گذشته تضمین اجازهٔ امروز نیست.</span></li></ol>
    <details class="org-pip-guide"><summary>مثال کامل: منابع انسانی → ویژگی معتبر → سیاست</summary><p>در منابع انسانی، فیلد activeEmployee مشخص می‌کند همکاری برقرار است یا نه. آن را به ویژگی boolean با نام employment.active نگاشت کنید؛ departmentCode هم به ویژگی string با نام organization.unit تبدیل می‌شود. شناسهٔ subject باید همان شناسهٔ پایدار هویت مرکزی باشد، نه نام نمایشی یا ایمیل متغیر.</p><p>قرارداد پاسخ شامل schemaVersion، tenantId، subject، sourceVersion، observedAt با منطقهٔ زمانی UTC و attributes است. دریافت برای هر هویت مستقل است. در این مثال عمر مجاز داده ۳۰۰ ثانیه و دریافت زمان‌بندی‌شده هر ۶۰ ثانیه است؛ اگر دریافت متوقف شود، داده پس از پایان اعتبار برای تصمیم قابل استفاده نیست.</p><pre dir="ltr"><code>{
  "schemaVersion": 1,
  "tenantId": "@Model.SelectedTenant",
  "subject": "employee-001",
  "sourceVersion": "hr-event-42",
  "observedAt": "2026-10-23T08:00:00Z",
  "attributes": { "activeEmployee": "true", "departmentCode": "engineering" }
}</code></pre><p class="org-calendar-note">زمان و شناسهٔ مثال را سامانهٔ مرجع باید با دادهٔ واقعی همان درخواست جایگزین کند. این متن، پاسخ زنده نیست. اتصال داخلی تنها به میزبان‌های مصوب تنظیمات سرور ممکن است؛ نوشتن دامنه در فرم به آن اعتماد شبکه نمی‌دهد. مدیر استقرار باید اتصال دقیق همین سازمان، نشانی سرویس و مرجع رمز را در تنظیمات سرور ثبت کند؛ بدون این اتصال مصوب، دریافت خارجی انجام نمی‌شود.</p></details>
    <div id="org-pip-overview" class="org-pip-overview" aria-label="وضعیت عملیاتی منابع اطلاعات"></div><p id="org-pip-message" role="status" aria-live="polite"></p><div class="panel-heading"><h4>منابع اطلاعات همین سازمان</h4><button type="button" class="button secondary" id="org-pip-refresh">تازه‌سازی وضعیت</button></div><div id="org-pip-sources" class="org-pip-list"></div>
    @if(Model.IsTemplateTenant && Model.IsAdmin){<div class="org-calendar-note"><p>نمونهٔ منابع انسانی در سازمان الگو، دادهٔ مصنوعی و سیاست پیش‌نویس دارد. این دکمه نمونهٔ جداگانه را ایجاد یا تازه می‌کند؛ سیاستی منتشر نمی‌شود و اتصال واقعی منابع انسانی نیست.</p><button type="button" class="button secondary" id="org-pip-example">آماده‌سازی نمونهٔ آموزشی و دادهٔ تازه</button><div id="org-pip-example-result" role="status" aria-live="polite"></div><h4>از اجازه تا توقف دسترسی، با علت قابل بررسی</h4><p>همکاری فعال و غیرفعال، واحد نادرست، دادهٔ مفقود یا منقضی، قطع منبع و محدودیت زمان را با هویت‌های مصنوعی مستقل آزمایش کنید. این سناریوها از زمان ثابت آموزشی استفاده می‌کنند و هیچ سیاست یا مجوز زنده‌ای منتشر نمی‌کنند.</p><button type="button" class="button secondary" id="org-pip-journey">اجرای مسیر کامل آموزشی PIP</button><div id="org-pip-journey-result" class="org-pip-journey" role="status" aria-live="polite"></div></div>}
    @if(Model.CanManagePip){<details class="org-calendar-editor" id="org-pip-editor"><summary>ثبت منبع اطلاعات جدید</summary><form id="org-pip-form" class="org-calendar-form">
    <label>نام و مسئول منبع <input name="name" required maxlength="200" placeholder="وضعیت همکاری · واحد منابع انسانی" /></label><label>نشانی سرویس HTTPS <input name="endpoint" type="url" required maxlength="2048" placeholder="https://hr.example.test/attributes" dir="ltr" /></label><label>میزبان همین سرویس <input name="allowedHost" required maxlength="253" placeholder="hr.example.test" dir="ltr" /></label>
    <label>نام مرجع رمز در سرور، اختیاری <input name="secretReference" maxlength="200" autocomplete="off" placeholder="hr-reader" dir="ltr" /></label><label>قرارداد پاسخ <select name="schemaVersion"><option value="1">۱ · ویژگی‌های نوع‌دار با عمر مجاز</option><option value="2">۲ · ویژگی‌های نوع‌دار با validUntil</option></select></label><label>حداکثر عمر داده، ثانیه <input name="maxAgeSeconds" type="number" min="1" max="86400" value="300" required /></label>
    <label>مهلت پاسخ، ثانیه <input name="timeoutSeconds" type="number" min="1" max="60" value="10" required /></label><label>حداکثر پاسخ، بایت <input name="maxResponseBytes" type="number" min="1024" max="1048576" value="262144" required /></label><label>فاصلهٔ دریافت، ثانیه <input name="pollIntervalSeconds" type="number" min="0" max="86400" value="0" required /><small>صفر: دستی؛ زمان‌بندی: حداقل ۳۰ و کمتر از عمر مجاز داده</small></label>
    <label class="org-reason">هویت‌های دریافت زمان‌بندی‌شده، هر خط یک شناسه <textarea name="syncSubjects" rows="3" maxlength="20000" dir="ltr" placeholder="employee-001&#10;employee-002"></textarea></label>
    <fieldset class="org-reason"><legend>ویژگی‌ها و نگاشت فیلدهای سامانهٔ مرجع</legend><p>فقط این ویژگی‌ها به سیاست می‌رسند. نام ثابت برای سیاست، نام فیلد خارجی و نوع داده را مشخص کنید. ویژگی لازمِ حذف‌شده، نوع اشتباه و پاسخ نامعتبر پذیرفته نمی‌شوند.</p><p class="org-calendar-note">API سازمان، عضویت و انتصاب زمان‌دار را گزارش می‌کند: org.member.active، org.assignment.active و org.assignment.count. کد واحد و نقش فقط برای دقیقاً یک انتصاب مؤثر می‌آیند. این ویژگی‌ها وضعیت استخدام نیستند؛ employment.active باید از مرجع مسئول استخدام دریافت شود. نسخهٔ ۲ پایان اعتبار validUntil را الزامی می‌کند و زودترینِ آن و عمر مجاز، پایان تازگی است.</p><div id="org-pip-definitions"></div><div class="org-calendar-actions"><button type="button" class="button secondary" id="org-pip-add-definition">افزودن ویژگی</button><button type="button" class="button secondary" id="org-pip-fill-example">پرکردن مثال منابع انسانی</button><button type="button" class="button secondary" id="org-pip-fill-hr">قرارداد API سازمان و انتصاب · نسخهٔ ۲</button></div></fieldset>
    <label class="org-reason">دلیل ثبت و مرجع مسئول داده <input name="reason" required maxlength="1000" placeholder="مثلاً مصوبهٔ اتصال به منابع انسانی و مسئول اعتبار اطلاعات" /></label><p class="org-reason org-calendar-note">منبع با وضعیت غیرفعال ذخیره می‌شود. پس از بررسی قرارداد و تنظیمات اتصال، آزمون اتصال و قرارداد را برای یک هویت اجرا کنید. آزمون موفق و تازه برای فعال‌سازی لازم است؛ سپس اولین دادهٔ تصمیم را دریافت کنید. رمز، توکن یا اطلاعات ورود را در نشانی یا این فرم وارد نکنید.</p><button type="submit" class="button primary">ثبت منبع غیرفعال</button>
    </form></details>}
    <section class="org-calendar-probe" id="org-pip-runs-section" hidden><h4 id="org-pip-runs-title">سوابق دریافت</h4><p class="muted">آخرین ۲۰ اجرا؛ موفقیت دریافت با تازگی دادهٔ مورد استفاده در یک تصمیم یکسان نیست. نتیجهٔ تصمیم را در بخش سیاست آزمایش کنید.</p><div id="org-pip-runs" role="status" aria-live="polite"></div></section>
    </section>}
    @if(Model.CanWrite){
    <section class="panel org-editor"><h3>ثبت تغییر سازمانی</h3><p class="muted">هر تغییر همراه با دلیل، عامل و نسخه ثبت می‌شود.</p><form id="org-command">
        <label>عملیات <select name="operation"><option value="unit.save">ثبت / ویرایش / انتقال واحد</option><option value="unit.archive">بایگانی واحد</option><option value="role.save">تعریف / ویرایش نقش سازمانی</option><option value="position.save">ثبت / ویرایش سمت سازمانی</option><option value="position.archive">بایگانی سمت</option><option value="appointment.add">انتصاب عضو</option><option value="appointment.end">خاتمه انتصاب</option></select></label>
        <label>رکورد موجود <select name="id"><option value="">رکورد جدید</option></select></label>
        <label>نام <input name="name" maxlength="200" /></label><label>کد <input name="code" maxlength="80" /></label>
        <label>واحد والد <select name="parentId"><option value="">ریشه سازمان</option></select></label>
        <label>نوع واحد <select name="kind"><option value="department">اداره</option><option value="division">معاونت</option><option value="team">تیم</option><option value="branch">شعبه</option></select></label>
        <label>واحد سمت <select name="unitId"></select></label><label>ظرفیت سمت <input name="capacity" type="number" value="1" min="1" max="10000" /></label>
        <label>نقش سازمانی سمت <select name="roleId"></select></label>
        <label>سمت انتصاب <select name="positionId"></select></label><label>شناسه هویت عضو <input name="subject" placeholder="شناسه پایدار عضو سازمان" /></label>
        <label>شروع <input name="from" type="datetime-local" /></label><label>پایان <input name="to" type="datetime-local" /></label>
        <label class="org-reason">دلیل تغییر <input name="reason" required maxlength="1000" /></label><button class="button primary" type="submit">ثبت تغییر</button>
    </form></section>}
    <section class="panel org-history"><div class="panel-heading"><h3>مقایسه نسخه‌های ساختار</h3></div><form id="org-compare" class="org-toolbar"><label>از نسخه <select id="org-compare-from"></select></label><label>تا نسخه <select id="org-compare-to"></select></label><button type="submit" class="button secondary">مقایسه تغییرات</button></form><p id="org-compare-status" role="status" aria-live="polite"></p><div id="org-compare-results"></div><button type="button" class="button secondary" id="org-compare-more" hidden>تغییرات بیشتر</button></section>
    <section class="panel org-history"><div class="panel-heading"><h3>مسیر تغییرات</h3><label>نمایش نسخه <select id="org-history"><option value="">نسخه جاری</option></select></label></div><p class="muted">نسخه‌های پیشین فقط برای مشاهده هستند.</p><ol id="org-timeline"></ol></section>
</div>
}
@section Scripts {<script src="~/js/organization.js" asp-append-version="true" defer></script>}

@page
@using Fanasa.AccessManagement.Web
@{ ViewData["Title"] = "مراکز قابلیت"; var pillars = CapabilityCatalog.All.GroupBy(x => x.Pillar).ToArray(); }
<div class="page-actions"><div><p class="eyebrow">catalog رسمی فن‌آسا</p><p class="muted">مرکز قابلیت، scope معماری و audience سامانه‌ها را مشخص می‌کند؛ grant واقعی همچنان tenant-scoped است.</p></div><a class="button secondary" href="https://fanasa.net/fa#centers" target="_blank" rel="noreferrer">منبع رسمی ↗</a></div>
<div class="metrics"><div class="metric"><span>مرکز قابلیت</span><strong>۱۴</strong><small>در ۵ پهنه معماری</small></div><div class="metric"><span>پهنه</span><strong>۵</strong><small>کسب‌وکار، هوش، زیرساخت، ساخت، کنترل</small></div><div class="metric accent"><span>قاعده دسترسی</span><strong>Tenant</strong><small>هیچ grant سراسری بدون tenant</small></div></div>
@foreach (var pillar in pillars){<section class="panel center-section"><div class="panel-heading"><h2>@pillar.Key</h2><span class="pill teal">@pillar.Count() مرکز</span></div><div class="center-grid">@foreach (var center in pillar){<article class="center-tile"><div class="tile-top"><span class="center-number">@center.Number</span><span class="tile-dot @center.Color"></span></div><h3>@center.Name</h3><p>@center.Description</p><code>@center.Audience</code><a href="@center.OfficialUrl" target="_blank" rel="noreferrer">معرفی مرکز ↗</a></article>}</div></section>}

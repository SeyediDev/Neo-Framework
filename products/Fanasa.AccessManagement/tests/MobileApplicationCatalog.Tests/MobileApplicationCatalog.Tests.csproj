<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AccessManagementSourceRoot Condition="'$(AccessManagementSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../src/Fanasa.AccessManagement.Web</AccessManagementSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(AccessManagementSourceRoot)/Fanasa.AccessManagement.Web.csproj" />
  </ItemGroup>
</Project>

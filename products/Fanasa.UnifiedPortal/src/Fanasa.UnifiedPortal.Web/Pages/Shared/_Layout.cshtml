<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · فن‌آسا</title>
    <link rel="icon" href="~/brand/fanasa-horizontal-fa.svg" />
    <style>
      @@font-face{font-family:Vazir;src:url('/fonts/vazir/Vazir-Regular.woff2') format('woff2');font-weight:400}@@font-face{font-family:Vazir;src:url('/fonts/vazir/Vazir-Bold.woff2') format('woff2');font-weight:700}:root{font-family:Vazir,Tahoma,Arial,sans-serif;color:#141c33;background:#f6f1e7}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 15% 10%,#fff7df 0 18%,transparent 40%),linear-gradient(135deg,#f6f1e7,#edf7f5)}main{width:min(92vw,760px);padding:52px 40px;background:#fffdf9;border-top:5px solid #1f4b9a;border-radius:22px;box-shadow:0 22px 60px #141c3322;text-align:center}.hero img{width:150px;height:auto;margin-bottom:16px}.eyebrow{display:block;color:#149a8e;font-size:13px;font-weight:700;letter-spacing:.04em}h1{font-size:32px;color:#1f4b9a;margin:10px 0 12px}p{line-height:2;color:#52617a}.button{display:inline-block;margin-top:22px;padding:14px 32px;border-radius:11px;background:#e0a334;color:#141c33;text-decoration:none;font-weight:800}.products{display:grid;gap:14px;margin:32px 0 20px;text-align:right}.product-card{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;padding:18px;border:1px solid #e6e1d8;border-radius:16px;color:#141c33;text-decoration:none;transition:transform .18s,box-shadow .18s,border-color .18s}.product-card:hover{transform:translateY(-2px);border-color:#21b5a8;box-shadow:0 8px 24px #141c3314}.product-card[aria-disabled=true]{opacity:.58;pointer-events:none}.product-card strong,.product-card small{display:block}.product-card small{margin-top:5px;color:#68748a;font-size:12px}.product-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;color:white;font-weight:700}.turquoise{background:#21b5a8}.saffron{background:#e0a334;color:#141c33}.arrow{font-size:22px;color:#1f4b9a}.account{display:flex;justify-content:space-between;gap:12px;align-items:center;padding-top:18px;border-top:1px solid #eee8df;color:#68748a;font-size:12px}.account a{color:#1f4b9a;text-decoration:none;font-weight:700}@@media(max-width:600px){main{padding:36px 22px}.account{align-items:flex-start;flex-direction:column}h1{font-size:26px}}
    </style>
</head>
<body><main>@RenderBody()</main></body>
</html>

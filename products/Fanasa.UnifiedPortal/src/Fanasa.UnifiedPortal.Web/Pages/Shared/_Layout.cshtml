@using System.Security.Claims
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f4b9a" />
    <meta name="description" content="پنجره واحد فن آسا؛ دسترسی یکپارچه به سامانه‌های سازمان و خدمات هوشمند." />
    <title>@ViewData["Title"] · فن آسا</title>
    <link rel="icon" href="~/brand/fanasa-horizontal-fa.svg" />
    <link rel="stylesheet" href="~/portal.css" asp-append-version="true" />
</head>
<body id="top">
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <div class="portal-shell">
        <nav class="portal-nav" aria-label="ناوبری اصلی">
            <a class="brand" href="/" aria-label="صفحه اصلی پنجره واحد فن آسا"><img src="~/brand/fanasa-horizontal-fa.svg" alt="فن آسا" width="164" height="56" /></a>
            <div class="nav-links"><a href="/#workspace">فضای کار</a><a href="/#centers">خدمات فن آسا</a></div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="account"><span class="account-name">@(User.FindFirstValue("preferred_username") ?? User.Identity.Name ?? "حساب سازمانی")</span><a href="/logout">خروج</a></div>
            }
            else { <a class="nav-login" href="/login">ورود به حساب <span aria-hidden="true">←</span></a> }
        </nav>
        <main id="main-content">@RenderBody()</main>
    </div>
</body>
</html>

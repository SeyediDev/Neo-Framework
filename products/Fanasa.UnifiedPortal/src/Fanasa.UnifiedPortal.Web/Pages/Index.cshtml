@page
@model Fanasa.UnifiedPortal.Web.Pages.IndexModel
@using System.Security.Claims
@{
    ViewData["Title"] = "پنجره واحد";
    var authenticated = User.Identity?.IsAuthenticated == true;
    var centers = new[]
    {
        new { Number = "01", Icon = "◈", Name = "ابرگان", Pillar = "کسب‌وکار و بازار", Description = "لایه کسب‌وکار دیجیتال و نقطه تماس آدم‌ها با فن‌آسا", Url = "https://fanasa.net/fa/centers/abrgan", Logo = "/brand/center-abrgan-mark-color.svg", Color = "business" },
        new { Number = "02", Icon = "◇", Name = "کاروان", Pillar = "کسب‌وکار و بازار", Description = "بازار عامل‌ها، مهارت‌ها و سرویس‌های فن‌آسا", Url = "https://fanasa.net/fa/centers/karavan", Logo = "/brand/center-karavan-mark-color.svg", Color = "business" },
        new { Number = "03", Icon = "✦", Name = "کاوان", Pillar = "هوش و عامل‌ها", Description = "محیط اجرای عامل‌ها با هویت، سیاست و ردگیری کامل", Url = "https://fanasa.net/fa/centers/kavan", Logo = "/brand/center-kavan-mark-color.svg", Color = "intelligence" },
        new { Number = "04", Icon = "⇄", Name = "پیوند", Pillar = "هوش و عامل‌ها", Description = "هاب اتصال عامل‌ها به ابزارها، سامانه‌ها و رویدادها", Url = "https://fanasa.net/fa/centers/peyvand", Logo = "/brand/center-peyvand-mark-color.svg", Color = "intelligence" },
        new { Number = "05", Icon = "⌬", Name = "دانا", Pillar = "هوش و عامل‌ها", Description = "پلتفرم داده و مدل؛ از داده خام تا دانش قابل‌بازیابی", Url = "https://fanasa.net/fa/centers/dana", Logo = "/brand/center-dana-mark-color.svg", Color = "intelligence" },
        new { Number = "06", Icon = "₿", Name = "بنیان", Pillar = "زیرساخت: مرکز و لبه", Description = "توان محاسباتی هوش مصنوعی فن‌آسا", Url = "https://fanasa.net/fa/centers/bonyan", Logo = "/brand/center-bonyan-mark-color.svg", Color = "infrastructure" },
        new { Number = "07", Icon = "☁", Name = "ابر فن‌آسا", Pillar = "زیرساخت: مرکز و لبه", Description = "ابر سازمانی و زیرساخت سلف‌سرویس از مرکز تا لبه", Url = "https://fanasa.net/fa/centers/fanasa-cloud", Logo = "/brand/center-fanasa-cloud-mark-color.svg", Color = "infrastructure" },
        new { Number = "08", Icon = "△", Name = "آسمان", Pillar = "زیرساخت: مرکز و لبه", Description = "زیرساخت فیزیکی فن‌آسا", Url = "https://fanasa.net/fa/centers/asman", Logo = "/brand/center-asman-mark-color.svg", Color = "infrastructure" },
        new { Number = "09", Icon = "⌁", Name = "کرانه", Pillar = "زیرساخت: مرکز و لبه", Description = "امتداد ابر فن‌آسا تا کارخانه، فروشگاه و دستگاه", Url = "https://fanasa.net/fa/centers/kerane", Logo = "/brand/center-kerane-mark-color.svg", Color = "infrastructure" },
        new { Number = "10", Icon = "⌘", Name = "رایان", Pillar = "ساخت", Description = "کارخانه ساخت عامل‌ها و نرم‌افزار فن‌آسا", Url = "https://fanasa.net/fa/centers/rayan", Logo = "/brand/center-rayan-mark-color.svg", Color = "build" },
        new { Number = "11", Icon = "⛨", Name = "دژان", Pillar = "کنترل", Description = "صفحه اعتماد و امنیت فن‌آسا", Url = "https://fanasa.net/fa/centers/dejan", Logo = "/brand/center-dejan-mark-color.svg", Color = "control" },
        new { Number = "12", Icon = "✧", Name = "آیین", Pillar = "کنترل", Description = "صفحه حاکمیت فن‌آسا", Url = "https://fanasa.net/fa/centers/ayin", Logo = "/brand/center-ayin-mark-color.svg", Color = "control" },
        new { Number = "13", Icon = "◌", Name = "دیده‌بان", Pillar = "کنترل", Description = "صفحه عملیات فن‌آسا", Url = "https://fanasa.net/fa/centers/didban", Logo = "/brand/center-didban-mark-color.svg", Color = "control" },
        new { Number = "14", Icon = "⚖", Name = "ترازو", Pillar = "کنترل", Description = "صفحه اقتصاد فن‌آسا", Url = "https://fanasa.net/fa/centers/tarazu", Logo = "/brand/center-tarazu-mark-color.svg", Color = "control" }
    };
}
<header class="portal-hero"><div class="hero-copy"><span class="eyebrow">فن‌آسا · فرصت‌های تازه برای کسب‌وکار شما</span><h1>ایده‌تان را<br /><em>هوشمندتر و سریع‌تر</em> رشد دهید.</h1><p>از یک پنجره به محصولات، سرویس‌ها و زیرساخت‌های هوشمند فن‌آسا دسترسی پیدا کنید؛ ساده شروع کنید، مطمئن توسعه دهید و با خیال راحت مقیاس بگیرید.</p><div class="hero-actions">@if (!authenticated){<a class="button" href="/login">شروع با SSO فن‌آسا <span aria-hidden="true">↗</span></a>}else{<a class="button" href="#products">ورود به سامانه‌های من <span aria-hidden="true">↗</span></a><div class="identity-chip"><span class="status-dot"></span><span>@(User.FindFirstValue("preferred_username") ?? User.FindFirstValue("email") ?? "کاربر سازمانی")</span><a href="/logout">خروج امن</a></div>}<a class="text-link" href="#centers">کشف قابلیت‌ها <span aria-hidden="true">↓</span></a></div><div class="hero-proof"><span>✓ دسترسی یکپارچه</span><span>✓ زیرساخت قابل اتکا</span><span>✓ رشد بدون پیچیدگی</span></div></div><div class="hero-orbit" aria-hidden="true"><span class="orbit-ring ring-one"></span><span class="orbit-ring ring-two"></span><span class="orbit-core">F</span><i class="orbit-node node-one">✦</i><i class="orbit-node node-two">◈</i><i class="orbit-node node-three">⌁</i></div></header>
<section class="portal-summary" aria-label="نمای کلی پنجره واحد"><div><strong>۱۴</strong><span>مرکز تخصصی</span></div><div><strong>۵</strong><span>حوزه توانمندی</span></div><div><strong>@Model.Products.Count</strong><span>سامانه در دسترس شما</span></div></section>
<section class="product-catalog" id="products" aria-label="سامانه‌های مجاز"><div class="catalog-heading"><div><span class="eyebrow">سرویس‌های شما، در یک نگاه</span><h2>از اینجا شروع کنید</h2></div><p>@Model.Products.Count سامانه</p></div>@if (Model.Products.Count == 0){<div class="catalog-empty"><strong>سامانه مناسب خود را از مرکز راهبری پلتفرم دریافت کنید.</strong><span>پس از ورود، سرویس‌هایی که برای شما فعال شده‌اند همین‌جا نمایش داده می‌شوند.</span></div>}else{<div class="product-grid">@foreach (var product in Model.Products){<a class="product-card" href="@(product.Url ?? "#")" target="_blank" rel="noreferrer"><span class="product-mark @product.Center">◈</span><span><strong>@product.DisplayName</strong><small>@product.Center · @product.Audience</small></span><span class="arrow">↗</span></a>}</div>}</section>
<section class="catalog" id="centers"><div class="catalog-heading"><div><span class="eyebrow">هویت رسمی مراکز قابلیت فن‌آسا</span><h2>۱۴ مرکز، ۵ پهنه</h2></div><p><span id="visible-count">۱۴</span> مرکز قابلیت</p></div><div class="catalog-tools"><label class="search-box"><span aria-hidden="true">⌕</span><input id="center-search" type="search" placeholder="جست‌وجو در مراکز قابلیت" aria-label="جست‌وجو در مراکز قابلیت" /></label><div class="filter-pills" role="group" aria-label="فیلتر مراکز"><button class="filter-pill is-active" type="button" data-filter="all">همه</button><button class="filter-pill" type="button" data-filter="کسب‌وکار و بازار">کسب‌وکار</button><button class="filter-pill" type="button" data-filter="هوش و عامل‌ها">هوش و عامل‌ها</button><button class="filter-pill" type="button" data-filter="زیرساخت: مرکز و لبه">زیرساخت</button><button class="filter-pill" type="button" data-filter="ساخت">ساخت</button><button class="filter-pill" type="button" data-filter="کنترل">کنترل</button></div></div><div class="center-grid" id="center-grid">@foreach (var center in centers){<article class="center-card @center.Color" data-state="@center.Pillar" data-search="@center.Name @center.Description @center.Pillar"><div class="center-top"><span class="center-number">@center.Number</span><span class="center-icon @center.Color"><img src="@center.Logo" alt="نشان @center.Name" loading="lazy" /></span></div><span class="center-pillar">@center.Pillar</span><h3>@center.Name</h3><p>@center.Description</p><div class="center-bottom"><span class="center-product">نشان رسمی مرکز</span><a class="center-link" href="@center.Url" target="_blank" rel="noreferrer" aria-label="معرفی @center.Name">↗</a></div></article>}</div><p class="no-results" id="no-results" hidden>مرکزی با این جست‌وجو پیدا نشد.</p></section>
<section class="portal-note"><span class="note-mark">✦</span><div><strong>یک پنجره، چند مسیر، یک هویت</strong><p>ورود، نقش‌ها و دسترسی‌ها در SSO مرکزی فن‌آسا مدیریت می‌شوند و هر محصول دامنه مستقل خودش را حفظ می‌کند.</p></div></section>
<script>(()=>{const cards=[...document.querySelectorAll('.center-card')],search=document.getElementById('center-search'),count=document.getElementById('visible-count'),empty=document.getElementById('no-results');let filter='all';const render=()=>{const query=(search.value||'').trim().toLocaleLowerCase();let shown=0;cards.forEach(card=>{const matches=(filter==='all'||card.dataset.state===filter)&&(!query||card.dataset.search.toLocaleLowerCase().includes(query));card.hidden=!matches;if(matches)shown++});count.textContent=shown;empty.hidden=shown!==0};search.addEventListener('input',render);document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter;document.querySelectorAll('[data-filter]').forEach(item=>item.classList.toggle('is-active',item===button));render()}));})();</script>

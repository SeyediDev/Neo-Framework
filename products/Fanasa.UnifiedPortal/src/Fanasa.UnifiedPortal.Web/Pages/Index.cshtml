@page
@model Fanasa.UnifiedPortal.Web.Pages.IndexModel
@using System.Security.Claims
@{
    ViewData["Title"] = "پنجره واحد";
    var authenticated = User.Identity?.IsAuthenticated == true;
    var centers = new[]
    {
        new { Number = "01", Icon = "◈", Name = "ابرگان", Pillar = "کسب‌وکار و بازار", Description = "لایه کسب‌وکار دیجیتال و نقطه تماس آدم‌ها با فن‌آسا", Url = "https://fanasa.net/fa/centers/abrgan", Logo = "/brand/center-abrgan-mark-color.svg", Color = "business" },
        new { Number = "02", Icon = "◇", Name = "کاروان", Pillar = "کسب‌وکار و بازار", Description = "بازار عامل‌ها، مهارت‌ها و سرویس‌های فن‌آسا", Url = "https://fanasa.net/fa/centers/karavan", Logo = "/brand/center-karavan-mark-color.svg", Color = "business" },
        new { Number = "03", Icon = "✦", Name = "کاوان", Pillar = "هوش و عامل‌ها", Description = "محیط اجرای عامل‌ها با هویت، سیاست و ردگیری کامل", Url = "https://fanasa.net/fa/centers/kavan", Logo = "/brand/center-kavan-mark-color.svg", Color = "intelligence" },
        new { Number = "04", Icon = "⇄", Name = "پیوند", Pillar = "هوش و عامل‌ها", Description = "هاب اتصال عامل‌ها به ابزارها، سامانه‌ها و رویدادها", Url = "https://fanasa.net/fa/centers/peyvand", Logo = "/brand/center-peyvand-mark-color.svg", Color = "intelligence" },
        new { Number = "05", Icon = "⌬", Name = "دانا", Pillar = "هوش و عامل‌ها", Description = "پلتفرم داده و مدل؛ از داده خام تا دانش قابل‌بازیابی", Url = "https://fanasa.net/fa/centers/dana", Logo = "/brand/center-dana-mark-color.svg", Color = "intelligence" },
        new { Number = "06", Icon = "₿", Name = "بنیان", Pillar = "زیرساخت: مرکز و لبه", Description = "توان محاسباتی هوش مصنوعی فن‌آسا", Url = "https://fanasa.net/fa/centers/bonyan", Logo = "/brand/center-bonyan-mark-color.svg", Color = "infrastructure" },
        new { Number = "07", Icon = "☁", Name = "ابر فن‌آسا", Pillar = "زیرساخت: مرکز و لبه", Description = "ابر سازمانی و زیرساخت سلف‌سرویس از مرکز تا لبه", Url = "https://fanasa.net/fa/centers/fanasa-cloud", Logo = "/brand/center-fanasa-cloud-mark-color.svg", Color = "infrastructure" },
        new { Number = "08", Icon = "△", Name = "آسمان", Pillar = "زیرساخت: مرکز و لبه", Description = "زیرساخت فیزیکی فن‌آسا", Url = "https://fanasa.net/fa/centers/asman", Logo = "/brand/center-asman-mark-color.svg", Color = "infrastructure" },
        new { Number = "09", Icon = "⌁", Name = "کرانه", Pillar = "زیرساخت: مرکز و لبه", Description = "امتداد ابر فن‌آسا تا کارخانه، فروشگاه و دستگاه", Url = "https://fanasa.net/fa/centers/kerane", Logo = "/brand/center-kerane-mark-color.svg", Color = "infrastructure" },
        new { Number = "10", Icon = "⌘", Name = "رایان", Pillar = "ساخت", Description = "کارخانه ساخت عامل‌ها و نرم‌افزار فن‌آسا", Url = "https://fanasa.net/fa/centers/rayan", Logo = "/brand/center-rayan-mark-color.svg", Color = "build" },
        new { Number = "11", Icon = "⛨", Name = "دژان", Pillar = "کنترل", Description = "صفحه اعتماد و امنیت فن‌آسا", Url = "https://fanasa.net/fa/centers/dejan", Logo = "/brand/center-dejan-mark-color.svg", Color = "control" },
        new { Number = "12", Icon = "✧", Name = "آیین", Pillar = "کنترل", Description = "صفحه حاکمیت فن‌آسا", Url = "https://fanasa.net/fa/centers/ayin", Logo = "/brand/center-ayin-mark-color.svg", Color = "control" },
        new { Number = "13", Icon = "◌", Name = "دیده‌بان", Pillar = "کنترل", Description = "صفحه عملیات فن‌آسا", Url = "https://fanasa.net/fa/centers/didban", Logo = "/brand/center-didban-mark-color.svg", Color = "control" },
        new { Number = "14", Icon = "⚖", Name = "ترازو", Pillar = "کنترل", Description = "صفحه اقتصاد فن‌آسا", Url = "https://fanasa.net/fa/centers/tarazu", Logo = "/brand/center-tarazu-mark-color.svg", Color = "control" }
    };
}
<header class="portal-hero">
    <div class="hero-copy">
        <span class="eyebrow">پنجره واحد فن آسا</span>
        <h1>همه ابزارهای کارتان،<br /><em>در یک پنجره.</em></h1>
        <p>به سامانه‌های سازمان خود دسترسی پیدا کنید و خدمات موردنیازتان را در میان قابلیت‌های فن آسا بیابید. یک حساب، یک مسیر روشن برای شروع کار.</p>
        <div class="hero-actions">
            @if (!authenticated) { <a class="button" href="/login">ورود به فضای کار <span aria-hidden="true">←</span></a> }
            else { <a class="button" href="#workspace">مشاهده سامانه‌های من <span aria-hidden="true">←</span></a> }
            <a class="text-link" href="#centers">آشنایی با خدمات <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-proof"><span>یک حساب برای همه خدمات</span><span>دسترسی متناسب با سازمان شما</span></div>
    </div>
    <aside class="hero-guide" aria-label="راهنمای شروع">
        <span class="guide-label">مسیر شما در فن آسا</span>
        <div class="guide-step"><span class="step-number">۱</span><div><strong>وارد شوید</strong><p>با حساب یکپارچه فن آسا</p></div></div>
        <div class="guide-step"><span class="step-number">۲</span><div><strong>سازمان خود را انتخاب کنید</strong><p>فضای کاری متناسب با دسترسی شما</p></div></div>
        <div class="guide-step"><span class="step-number">۳</span><div><strong>کار را شروع کنید</strong><p>با سامانه‌ها و خدمات سازمانتان</p></div></div>
        <a class="guide-link" href="#workspace">رفتن به فضای کار <span aria-hidden="true">↙</span></a>
    </aside>
</header>

<section class="workspace-panel" id="workspace" aria-labelledby="workspace-title" data-status="@Model.Status">
    <div class="catalog-heading">
        <div><span class="eyebrow">فضای کار شما</span><h2 id="workspace-title">سامانه‌های سازمان</h2></div>
        <span class="section-badge" id="product-count">@Model.Products.Count سامانه</span>
    </div>
    @if (authenticated)
    {
        <form class="organization-form" method="get" action="/#workspace" id="organization-form">
            <div class="organization-field">
                <label for="organization-select">سازمان فعال</label>
                <select name="tenantId" id="organization-select" disabled="@(Model.Organizations.Count == 0)" aria-describedby="workspace-status">
                    <option value="">@(Model.Organizations.Count == 0 ? "سازمانی در دسترس نیست" : "سازمان موردنظر را انتخاب کنید")</option>
                    @foreach (var organization in Model.Organizations)
                    {
                        <option value="@organization.Id" selected="@(organization.Id == Model.ActiveOrganizationId)">@organization.Name</option>
                    }
                </select>
            </div>
            <button class="button button-secondary" type="submit" id="organization-submit" disabled="@(Model.Organizations.Count == 0)">نمایش سامانه‌ها <span aria-hidden="true">←</span></button>
            <button class="refresh-button" type="button" id="workspace-refresh">تازه‌سازی فهرست <span aria-hidden="true">↻</span></button>
        </form>
    }
    <p id="workspace-status" class="workspace-status @(Model.Status is CatalogStatus.Forbidden or CatalogStatus.Unavailable or CatalogStatus.NotConfigured ? "is-error" : "")" role="status" aria-live="polite">@Model.Message</p>
    <div class="catalog-empty" id="workspace-empty" hidden="@(Model.Products.Count > 0)">
        <span class="empty-symbol" aria-hidden="true">◇</span>
        <strong id="empty-title">@(authenticated ? "فضای کار شما از اینجا آغاز می‌شود" : "سامانه‌های شما پس از ورود نمایش داده می‌شوند")</strong>
        <p id="empty-description">@(authenticated ? Model.Message : "وارد حساب خود شوید تا سازمان‌ها و سامانه‌های مجازتان را ببینید.")</p>
        @if (!authenticated || Model.Status == CatalogStatus.SignInRequired) { <a class="button button-secondary" href="/login">ورود به حساب فن آسا</a> }
    </div>
    <div class="product-grid" id="product-grid" hidden="@(Model.Products.Count == 0)">
        @foreach (var product in Model.Products)
        {
            var url = Fanasa.UnifiedPortal.Web.Pages.IndexModel.SafeProductUrl(product.Url);
            <article class="product-card">
                <span class="product-mark" aria-hidden="true">◈</span>
                <div class="product-details"><h3>@product.DisplayName</h3><p>@Model.ActiveOrganizationName</p></div>
                @if (url is not null) { <a class="product-open" href="@url" target="_blank" rel="noopener noreferrer" aria-label="ورود به @product.DisplayName">ورود به سامانه <span aria-hidden="true">↗</span></a> }
                else { <span class="unavailable-link">نشانی سامانه هنوز آماده نیست</span> }
            </article>
        }
    </div>
</section>

<section class="catalog" id="centers" aria-labelledby="centers-title">
    <div class="catalog-heading">
        <div><span class="eyebrow">خدمات و توانمندی‌ها</span><h2 id="centers-title">برای قدم بعدی، کشف کنید</h2><p class="section-description">۱۴ مرکز تخصصی؛ از ساخت محصول و هوش مصنوعی تا زیرساخت و مدیریت کسب‌وکار.</p></div>
        <span class="section-badge" aria-live="polite"><span id="visible-count">۱۴</span> مرکز</span>
    </div>
    <div class="catalog-tools">
        <label class="search-box"><span aria-hidden="true">⌕</span><input id="center-search" type="search" placeholder="جست‌وجوی نام مرکز یا خدمت…" aria-label="جست‌وجو در مراکز قابلیت" /></label>
        <div class="filter-pills" role="group" aria-label="فیلتر مراکز">
            <button class="filter-pill is-active" aria-pressed="true" type="button" data-filter="all">همه</button>
            <button class="filter-pill" aria-pressed="false" type="button" data-filter="کسب‌وکار و بازار">کسب‌وکار</button>
            <button class="filter-pill" aria-pressed="false" type="button" data-filter="هوش و عامل‌ها">هوش و عامل‌ها</button>
            <button class="filter-pill" aria-pressed="false" type="button" data-filter="زیرساخت: مرکز و لبه">زیرساخت</button>
            <button class="filter-pill" aria-pressed="false" type="button" data-filter="ساخت">ساخت</button>
            <button class="filter-pill" aria-pressed="false" type="button" data-filter="کنترل">کنترل</button>
        </div>
    </div>
    <div class="center-grid" id="center-grid">
        @foreach (var center in centers)
        {
            <article class="center-card @center.Color" data-state="@center.Pillar" data-search="@center.Name @center.Description @center.Pillar">
                <div class="center-top"><span class="center-icon"><img src="@center.Logo" alt="نشان @center.Name" loading="lazy" width="40" height="40" /></span><span class="center-pillar">@center.Pillar</span></div>
                <h3>@center.Name</h3><p>@center.Description</p>
                <a class="center-link" href="@center.Url" target="_blank" rel="noopener noreferrer" aria-label="آشنایی با خدمات @center.Name">آشنایی با خدمات <span aria-hidden="true">↗</span></a>
            </article>
        }
    </div>
    <p class="no-results" id="no-results" hidden>مرکزی پیدا نشد. نام یا عبارت دیگری را جست‌وجو کنید.</p>
</section>
<footer class="portal-note"><img src="/brand/fanasa-horizontal-fa.svg" alt="فن آسا" width="120" height="42" /><p>یک هویت، دسترسی به دنیایی از قابلیت‌ها.</p><a href="#top">بازگشت به بالا ↑</a></footer>
<script src="~/portal.js" asp-append-version="true" defer></script>

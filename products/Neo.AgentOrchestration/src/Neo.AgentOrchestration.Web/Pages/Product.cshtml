@page "/product"
@model Neo.AgentOrchestration.Web.Pages.ProductModel
@{ ViewData["Title"] = "نئو؛ از ایده تا نتیجه"; }
<link rel="stylesheet" href="~/product.css" asp-append-version="true" />
<div class="product-page">
<nav class="product-nav" aria-label="معرفی محصول"><span dir="ltr">NEO / WORK &amp; AGENTS</span><div><a href="#capabilities">قابلیت‌ها</a><a href="#journey">روال کار</a><a href="#roadmap">مسیر آینده</a></div></nav>
<section class="product-hero" aria-labelledby="product-title">
<div class="product-copy"><p class="product-kicker"><span aria-hidden="true">◆</span> مدیریت کار، با نگاه ایجنتی</p><h1 id="product-title">ایده‌ها را روشن کن.<br />کارها را <em>به نتیجه برسان.</em></h1><p class="product-intro">یک جای مشخص برای پروژه‌ها، آدم‌ها و ایجنت‌ها. کار را تعریف کن، مسئولیت را بسپار و مسیر تصمیم تا نتیجه را با زمان، سابقه و شواهد دنبال کن.</p><div class="product-actions"><a class="button" asp-page="/Index">ورود به پنل <span aria-hidden="true">↗</span></a><a class="product-text-link" href="#capabilities">نئو را بشناس <span aria-hidden="true">↓</span></a></div><p class="product-caption">محصول مستقل روی Neo Framework · با هویت فن‌آسا</p></div>
<div class="product-preview" aria-label="نمونهٔ نمایشی گردش کار؛ دادهٔ واقعی نیست">
<div class="preview-top"><span class="preview-dots" aria-hidden="true">● ● ●</span><span dir="ltr">A CLEAR PATH TO DONE</span></div>
<div class="preview-heading"><span>از درخواست تا تحویل</span><span class="preview-label">نمونهٔ نمایشی</span></div>
<ol class="preview-flow"><li><span class="step-icon">۱</span><div><small>تعریف مسئله</small><strong>یک ایده، یک کار روشن</strong></div><span class="preview-state">تعریف‌شده</span></li><li><span class="step-icon">۲</span><div><small>مسئولیت مشخص</small><strong>رول مناسب، گام بعدی مشخص</strong></div><span class="preview-state">برنامه‌ریزی</span></li><li><span class="step-icon">۳</span><div><small>بازبینی و شواهد</small><strong>نتیجه‌ای که می‌شود بررسی کرد</strong></div><span class="preview-state">بازبینی</span></li></ol>
<div class="preview-note"><span aria-hidden="true">↳</span> هر کار، داستانی قابل پیگیری دارد.</div>
</div></section>
<div class="product-signature" dir="ltr" lang="en"><span>Seeking The Best</span><strong>For The Best<span aria-hidden="true">.</span></strong></div>
<section class="product-section" id="capabilities"><div class="section-heading"><div><p class="product-kicker">همین حالا در محصول</p><h2>کمتر دنبال کار بگرد.<br />بیشتر روی نتیجه تمرکز کن.</h2></div><p>قابلیت‌هایی برای اینکه بدانید چه کاری، دست چه کسی است و تا کجا پیش رفته.</p></div><div class="capability-grid">
<article><span class="feature-number" aria-hidden="true">01</span><h3>یک تصویر روشن از کارها</h3><p>کانبان، پروژه و دامین، تسک و زیرتسک، یوزر استوری و معیار پذیرش؛ همراه با فیلتر و بایگانی.</p><span class="feature-status">در دسترس</span></article>
<article><span class="feature-number" aria-hidden="true">02</span><h3>مسئولیت، بدون ابهام</h3><p>نمای کارهای هر رول، مالکیت مشخص و کنترل نسخه؛ برای هماهنگی کار انسان و ایجنت.</p><span class="feature-status">در دسترس</span></article>
<article><span class="feature-number" aria-hidden="true">03</span><h3>زمان و سابقه در کنار نتیجه</h3><p>زمان صرف‌شده و برآورد، یادداشت‌ها، تاریخچه و شواهد تست و کامیت در کنار هر کار.</p><span class="feature-status">در دسترس</span></article>
<article><span class="feature-number" aria-hidden="true">04</span><h3>شروع با یک الگوی مشخص</h3><p>الگوهای نسخه‌دار پروژه، پیش‌نمایش و تعریف فلو با شروط تحویل و بازبینی.</p><span class="feature-status">در دسترس</span></article>
</div></section>
<section class="product-journey product-section" id="journey"><div class="section-heading"><div><p class="product-kicker">یک مسیر، مسئولیت‌های روشن</p><h2>کار خوب، اتفاقی جلو نمی‌رود.</h2></div><p>فلو را متناسب با پروژه تعریف کنید. اتصال به هارنس اجرایی به پیکربندی و اجازهٔ صریح نیاز دارد.</p></div><ol class="journey-steps"><li><b>۱</b><h3>تعریف</h3><p>درخواست و معیار پذیرش را روشن کنید.</p></li><li><b>۲</b><h3>تخصیص</h3><p>رول، مسئول و وابستگی‌ها را مشخص کنید.</p></li><li><b>۳</b><h3>بررسی</h3><p>نتیجه و شواهد را بازبینی کنید.</p></li><li><b>۴</b><h3>تحویل</h3><p>با سابقهٔ محفوظ، کار را تکمیل کنید.</p></li></ol></section>
<section class="product-section" id="roadmap"><div class="section-heading"><div><p class="product-kicker">شفاف دربارهٔ آینده</p><h2>از مدیریت کار، تا هماهنگی در مقیاس.</h2></div><p>موارد زیر در نقشهٔ راه‌اند؛ عرضهٔ کامل یا آماده‌بودن برای محیط عملیاتی را ادعا نمی‌کنیم.</p></div><div class="roadmap-grid"><article><span>در نقشهٔ راه</span><h3>توکن و بودجه</h3><p>مصرف گزارش‌شده، برآورد و بودجهٔ اجرا، با منبع قابل پیگیری.</p></article><article><span>در نقشهٔ راه</span><h3>تیم‌ها و سرورها</h3><p>عضویت، دسترسی و سرورهای اجرای ایزوله برای چند تیم.</p></article><article><span>در نقشهٔ راه</span><h3>SaaS و موبایل</h3><p>ارائهٔ چندمستاجری و فرمان‌دادن و پیگیری کار از PWA.</p></article></div><p class="product-caption">پایهٔ پروتکل‌های LSP و ACP موجود است؛ اتصال کامل ایجنت و همگام‌سازی پیوستهٔ GitHub هنوز مراحل مستقلی دارند.</p></section>
<section class="product-cta"><div><p class="product-kicker">از یک کار شروع کنید.</p><h2>قدم بعدی را روشن‌تر بردارید.</h2></div><a class="button" asp-page="/Index">باز کردن فضای کاری <span aria-hidden="true">←</span></a></section>
</div>

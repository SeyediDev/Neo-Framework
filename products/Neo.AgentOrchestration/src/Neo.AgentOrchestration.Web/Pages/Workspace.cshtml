@page
@model Neo.AgentOrchestration.Web.Pages.WorkspaceModel
@{ ViewData["Title"] = "انتخاب نشست کاری"; }
<section class="session-hero"><div><p class="eyebrow">نشست سازمانی فن‌آسا</p><h1>به فضای کاری خودت برگرد</h1><p>سازمان و فضای کاری را بر اساس دسترسی فعلی‌ات انتخاب کن. مجوزها از هویت مرکزی خوانده می‌شوند.</p></div><div class="identity-card"><span class="identity-avatar" aria-hidden="true">@(Model.IdentityName[..1].ToUpperInvariant())</span><div><strong>@Model.IdentityName</strong>@if(Model.IdentityEmail is {} email){<small>@email</small>}<small dir="ltr">شناسه نشست: @Model.IdentitySubject[..Math.Min(12, Model.IdentitySubject.Length)]…</small></div></div></section>
@if (Model.Error is {} error) { <div class="alert" role="alert">@error <a asp-page="/Login">ورود مجدد</a></div> }
@if (Model.Access.Organizations.Count == 0 && Model.Error is null) { <section class="panel empty session-empty"><div class="empty-icon" aria-hidden="true">⌂</div><h2>هنوز فضای کاری مجازی برای این حساب پیدا نشد</h2><p>از مدیر سازمان بخواهید دسترسی خواندن به یک سازمان و فضای کاری را برای حساب SSO شما فعال کند.</p><a class="button" asp-page="/Logout">خروج از نشست</a></section> }
else { <section class="workspace-list"><div class="section-heading"><div><p class="eyebrow">دسترسی‌های شما</p><h2>انتخاب سازمان و فضای کاری</h2></div><span class="access-count">@Model.Access.Organizations.Sum(x => x.Workspaces.Count) فضای کاری</span></div><div class="organization-grid">@foreach (var organization in Model.Access.Organizations) {<article class="organization-card"><div class="organization-heading"><span class="organization-mark">@organization.Name[..1]</span><div><h3>@organization.Name</h3><small dir="ltr">@organization.Key</small></div></div><div class="workspace-options">@foreach (var workspace in organization.Workspaces) {<a class="workspace-option" asp-page="/Workspace" asp-route-organizationId="@workspace.OrganizationId" asp-route-workspaceId="@workspace.Id"><span><strong>@workspace.Name</strong><small dir="ltr">@workspace.Key</small></span><span class="workspace-arrow" aria-hidden="true">←</span></a>}</div></article>}</div></section> }

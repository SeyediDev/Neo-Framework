@page "/work/{organizationId:guid}/{workspaceId:guid}/manage"
@model Neo.AgentOrchestration.Web.Pages.ManageModel
@{ViewData["Title"]="تنظیمات فضای کاری";}
<partial name="_ScopeNav" model="Model" /><p class="eyebrow">پیکربندی قابل مدیریت</p><h1>پروژه‌ها، رول‌ها و فلوها</h1>
@if (TempData["ProjectDeleted"] is string deleted) { <div class="notice" role="status">@deleted</div> }
<p>این فرم‌ها به مجوز configure نیاز دارند. هیچ رمز، توکن یا connection string در پروفایل‌ها ثبت نکنید.</p>
<nav class="tabs"><a href="#projects">پروژه‌ها</a><a href="#roles">رول‌ها</a><a href="#agents">ایجنت‌ها</a><a href="#workflows">فلوها</a></nav>
@if(Model.Catalog is {} c){
<section class="panel" id="projects"><h2>پروژه‌ها</h2><div class="forms">@foreach(var p in c.Projects.Prepend(new ProjectView(Guid.Empty,"","",true))){
<div><h3>@(p.Id==Guid.Empty?"پروژه جدید":p.Name)</h3><form method="post" asp-page-handler="Project"><input name="Id" value="@p.Id" type="hidden" /><label>کلید<input name="Key" value="@p.Key" readonly="@(p.Id!=Guid.Empty)" required maxlength="80" /></label><label>نام<input name="Name" value="@p.Name" required maxlength="200" /></label><button>ذخیره پروژه</button></form>
@if(p.Id!=Guid.Empty){<a asp-page="/DeleteProject" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-projectId="@p.Id">حذف پروژه و کارهای وابسته…</a>}
@if(p.Id!=Guid.Empty){<details class="repository-binding"><summary>اتصال ریپازیتوری @(p.RepositoryBinding is null ? "· تعریف‌نشده" : "· "+p.RepositoryBinding.Provider)</summary><form method="post" asp-page-handler="Repository" class="form-grid"><input type="hidden" name="Id" value="@p.Id" /><label>ارائه‌دهنده<input name="RepositoryProvider" value="@p.RepositoryBinding?.Provider" placeholder="github / gitlab / azure" required /></label><label>آدرس ریپازیتوری<input name="RepositoryUrl" value="@p.RepositoryBinding?.RepositoryUrl" dir="ltr" maxlength="2000" required /></label><label>کلید ریپازیتوری<input name="RepositoryKey" value="@p.RepositoryBinding?.RepositoryKey" dir="ltr" required /></label><label>شاخه اصلی<input name="RepositoryDefaultBranch" value="@(p.RepositoryBinding?.DefaultBranch ?? "main")" dir="ltr" required /></label><label>شاخه توسعه<input name="RepositoryDevelopmentBranch" value="@p.RepositoryBinding?.DevelopmentBranch" dir="ltr" /></label><label>مرجع CI/CD<input name="RepositoryCiCdReference" value="@p.RepositoryBinding?.CiCdReference" dir="ltr" /></label><label>مرجع Secret<input name="RepositorySecretReference" value="@p.RepositoryBinding?.SecretReference" dir="ltr" /></label><label class="check"><input type="checkbox" name="RepositoryEnabled" value="true" checked="@(p.RepositoryBinding?.IsEnabled ?? true)" />فعال</label><div><button>ذخیره اتصال</button></div></form></details>}@if(p.Id!=Guid.Empty && p.IsEnabled){<form method="post" asp-page-handler="DisableProject"><input name="Id" value="@p.Id" type="hidden" /><button class="quiet">غیرفعال‌کردن پروژه</button></form>}else if(!p.IsEnabled){<span class="tag">غیرفعال</span>}</div>}
</div></section>
<section class="panel" id="roles"><h2>رول‌ها</h2><div class="forms">@foreach(var r in c.Roles.Prepend(new RoleProfileView(Guid.Empty,"","",null,true))){
<div><h3>@(r.Id==Guid.Empty?"رول جدید":r.Name)</h3><form method="post" asp-page-handler="Role"><input type="hidden" name="Id" value="@r.Id" /><label>کلید<input name="Key" value="@r.Key" readonly="@(r.Id!=Guid.Empty)" required /></label><label>نام<input name="Name" value="@r.Name" required /></label><label>ظرفیت هم‌زمان<input name="MaxConcurrentWorkItems" type="number" min="1" max="16" value="@r.MaxConcurrentWorkItems" required /></label><label>محدوده مسئولیت<textarea name="ScopeDescription" rows="3">@r.ScopeDescription</textarea></label><button>ذخیره رول</button></form>
@if(r.Id!=Guid.Empty){<form method="post" asp-page-handler="RoleEnabled"><input type="hidden" name="Id" value="@r.Id" /><input type="hidden" name="Enabled" value="@(!r.IsEnabled)" /><button class="quiet">@(r.IsEnabled?"غیرفعال‌کردن":"فعال‌کردن")</button></form>}</div>}
</div></section>
<section class="panel" id="agents"><h2>پروفایل ایجنت‌ها</h2><p class="muted">provider برابر fake برای شبیه‌سازی و http.name برای اتصال HTTP تعریف‌شده توسط مدیر نصب است. آدرس و رمز اتصال در تنظیمات امن سرور هستند، نه در پروفایل یا دستورالعمل ایجنت.</p>
@foreach(var a in c.Agents.Prepend(new AgentProfileView(Guid.Empty,Guid.Empty,"","","fake",null,null,null,true))){
<details open="@(a.Id==Guid.Empty)"><summary>@(a.Id==Guid.Empty?"ایجنت جدید":a.Name+" · "+a.Provider+" · "+(a.IsEnabled?"فعال":"غیرفعال"))</summary><form method="post" asp-page-handler="Agent" class="form-grid"><input type="hidden" name="Id" value="@a.Id" /><label>رول<select name="RoleId" disabled="@(a.Id!=Guid.Empty)">@foreach(var r in c.Roles){<option value="@r.Id" selected="@(a.RoleProfileId==r.Id)">@r.Name</option>}</select></label><label>کلید<input name="Key" value="@a.Key" readonly="@(a.Id!=Guid.Empty)" required /></label><label>نام<input name="Name" value="@a.Name" required /></label><label>ارائه‌دهنده<input name="Provider" value="@a.Provider" required dir="ltr" /></label><label>مدل<input name="AgentModel" value="@a.Model" dir="ltr" /></label><label>مسیر Skill<input name="SkillPath" value="@a.SkillPath" dir="ltr" /></label><label class="wide">دستورالعمل رول<textarea name="Instructions" rows="5" maxlength="32000">@a.Instructions</textarea></label><div><button>ذخیره پروفایل</button></div></form>
@if(a.Id!=Guid.Empty){<form method="post" asp-page-handler="AgentEnabled"><input type="hidden" name="Id" value="@a.Id" /><input type="hidden" name="Enabled" value="@(!a.IsEnabled)" /><button class="quiet">@(a.IsEnabled?"غیرفعال‌کردن":"فعال‌کردن")</button></form>}</details>}
</section>
<section class="panel" id="workflows"><h2>فلو و شروط تحویل</h2><form method="post" asp-page-handler="Workflow" class="filters"><label>پروژه<select name="ProjectId">@foreach(var p in c.Projects.Where(x=>x.IsEnabled)){<option value="@p.Id">@p.Name</option>}</select></label><label>کلید<input name="Key" required /></label><label>نام<input name="Name" required /></label><button>ایجاد فلو</button></form>
@foreach(var flow in c.Workflows){<details><summary>@flow.Name · @Model.Project(flow.ProjectId) · @(flow.IsEnabled?"فعال":"غیرفعال")</summary><form method="post" asp-page-handler="Workflow" class="filters"><input type="hidden" name="Id" value="@flow.Id" /><input type="hidden" name="Version" value="@flow.Version" /><label>نام<input name="Name" value="@flow.Name" required /></label><label class="check"><input type="checkbox" name="Enabled" value="true" checked="@flow.IsEnabled" />فعال</label><button>ذخیره فلو</button></form>
<h3>انتقال جدید</h3><partial name="_TransitionForm" model="@(new Neo.AgentOrchestration.Web.Pages.TransitionEditor(c,flow,null))" />
@foreach(var transition in flow.Transitions){<details><summary>@transition.Key · @transition.FromStatus → @transition.ToStatus</summary><partial name="_TransitionForm" model="@(new Neo.AgentOrchestration.Web.Pages.TransitionEditor(c,flow,transition))" /></details>}
</details>}
</section><section class="notice"><h2>اتصال‌های مدیریت کار</h2><p>Neo فعال است. GitHub، GitLab و Azure DevOps به‌صورت اتصال اختیاری برنامه‌ریزی شده‌اند؛ هنوز نصب یا فعال نشده‌اند.</p></section>
}

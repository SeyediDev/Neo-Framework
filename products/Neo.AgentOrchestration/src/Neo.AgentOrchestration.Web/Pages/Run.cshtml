@page "/work/{organizationId:guid}/{workspaceId:guid}/runs/{id:guid}"
@model Neo.AgentOrchestration.Web.Pages.RunModel
@{ViewData["Title"]="مانیتور اجرا";}
<partial name="_ScopeNav" model="Model" /><h1>مانیتور اجرا</h1>
@if(Model.Run is {} details && Model.Work is {} work){var run=details.Run;
<section class="panel"><p class="eyebrow">اجرای @run.Hop · @Model.Role(run.RoleId)</p><h2>@run.Status <span class="tag">@run.Decision</span></h2><p class="prose">@run.ResultSummary</p><p class="prose">@run.DecisionReason</p>
<dl><dt>درخواست‌کننده</dt><dd>@run.RequestedByAgentId / @run.RequestedByChatId</dd><dt>ارائه‌دهنده / مدل</dt><dd>@run.Provider / @run.Model</dd><dt>زمان‌ها (UTC)</dt><dd dir="ltr">@run.CreatedAtUtc.ToString("u") → @run.DispatchedAtUtc?.ToString("u") → @run.CompletedAtUtc?.ToString("u")</dd><dt>برنچ ثبت‌شده</dt><dd dir="ltr">@run.Branch</dd></dl>
<details><summary>پروفایل ثبت‌شده در لحظه اجرا</summary><p class="prose">@run.Instructions</p><p dir="ltr">@run.SkillPath</p></details>
<a asp-page="/Item" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@run.WorkItemId">بازگشت به کار</a><a asp-page="/Run" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@run.Id">تازه‌سازی</a>
@if(run.PreviousRunId is {} prev){<a asp-page="/Run" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@prev">اجرای قبلی</a>} @if(run.NextRunId is {} next){<a asp-page="/Run" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@next">اجرای بعدی</a>}</section>
<section class="panel"><h2>تحویل پیام‌ها</h2><div class="table-scroll"><table><thead><tr><th>عملیات</th><th>وضعیت صف</th><th>تلاش ارسال / اجرا</th><th>خطای قابل نمایش</th><th>موعد تلاش بعدی</th></tr></thead><tbody>@foreach(var d in details.Deliveries){<tr><td>@d.Kind <small dir="ltr">#@d.OutboxId</small></td><td>@d.State</td><td>@d.DispatchAttempts / @d.ExecutionAttempts</td><td>@d.Error</td><td>@d.RetryAtUtc?.ToString("u")</td></tr>}</tbody></table></div><p>پذیرش در صف به معنی تکمیل کار نیست. پیام ناموفق خودکار پاک یا بازنشانی نمی‌شود.</p></section>
<section class="panel forms">@if(Model.Flow is {} flow){<form method="post" asp-page-handler="Evaluate"><input type="hidden" name="RequestId" value="@Model.RequestId" /><input type="hidden" name="WorkItemVersion" value="@work.Item.Version" /><input type="hidden" name="WorkflowVersion" value="@flow.Version" /><p>پس از رفع علت توقف و بررسی نسخه جدید فلو، شروط را دوباره ارزیابی کنید.</p><button>درخواست ارزیابی مجدد</button></form>}
<form method="post" asp-page-handler="Return"><input type="hidden" name="WorkItemVersion" value="@work.Item.Version" /><p>فقط درخواست‌کننده می‌تواند کنترل اجرای پایان‌یافته/متوقف‌شده را پس بگیرد؛ اجرای فعال آزاد نمی‌شود.</p><button class="secondary">بازگرداندن مالکیت کار به من</button></form></section>
}

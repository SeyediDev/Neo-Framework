@page "/work/{organizationId:guid}/{workspaceId:guid}/items/{id:guid}"
@model Neo.AgentOrchestration.Web.Pages.ItemModel
@using static Neo.AgentOrchestration.Web.Pages.WorkPageModel
@{ViewData["Title"]=Model.Details?.Item.Title??"جزئیات کار";}
<partial name="_ScopeNav" model="Model" />
@if(Model.Details is {} details && Model.Catalog is {} catalog){var item=details.Item;
<div class="page-heading"><div><p class="eyebrow" dir="ltr">@item.Key · @item.Domain</p><h1>@item.Title</h1><p>@Model.Project(item.ProjectId) · @Status(item.Status) · @Model.Role(item.OwnerRoleId) @(item.IsArchived ? "· بایگانی" : "")</p></div><a class="button" asp-page="/NewItem" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-ProjectId="@item.ProjectId" asp-route-ParentWorkItemId="@item.Id">ایجاد زیرتسک</a></div>
<nav class="tabs" aria-label="بخش‌های کار"><a href="#description">شرح</a><a href="#actions">عملیات</a><a href="#children">زیرتسک‌ها</a><a href="#runs">اجراها</a><a href="#history">سابقه</a></nav>
<section class="panel" id="description"><h2>شرح درخواست <span class="tag">@ItemTypeLabel(item.Type)</span></h2><div class="prose" data-testid="description">@(item.Description??"شرح ثبت نشده است.")</div><h3>معیار پذیرش</h3><div class="prose" data-testid="acceptance-criteria">@(item.AcceptanceCriteria??"معیار پذیرش جداگانه ثبت نشده است؛ شرح درخواست را نیز بررسی کنید.")</div><p class="small" dir="ltr">Owner: @item.OwnerAgentId / @item.OwnerChatId</p>
@if(!item.IsArchived && item.Status is not ("Done" or "Cancelled")){
<details><summary>ویرایش نوع و معیار پذیرش</summary><form method="post" asp-page-handler="Planning"><input type="hidden" name="Version" value="@item.Version" /><label>نوع کار<select name="ItemType">@foreach(var type in ItemTypes){<option value="@type" selected="@(item.Type==type)">@ItemTypeLabel(type)</option>}</select></label><label>معیار پذیرش<textarea name="AcceptanceCriteria" rows="5" maxlength="8000">@item.AcceptanceCriteria</textarea></label><button>ذخیره برنامه‌ریزی</button><p class="small">شرح اولیه محفوظ می‌ماند؛ تغییر معیار پذیرش در سابقه ثبت می‌شود.</p></form></details>
}</section>
<section class="panel" id="metering"><h2>زمان و توکن</h2><partial name="_ItemMeter" model="item" /><p class="small">مصرف بودجه، درصد تکمیل کار نیست. مصرف هر کار مستقل است؛ زیرتسک‌ها دوباره در مصرف والد شمرده نمی‌شوند. گزارش توکن، تأیید صورتحساب نیست.</p></section>
<section class="panel" id="actions"><h2>عملیات کار</h2><p class="muted">API مالکیت و نسخه رکورد را کنترل می‌کند. اجرای مدیریت‌شده را ابتدا از صفحه اجرای مربوطه به خود برگردانید.</p><div class="forms">
<form method="post" asp-page-handler="Status"><input type="hidden" name="Version" value="@item.Version" /><label>وضعیت بعدی<select name="NextStatus">@foreach(var s in Statuses){<option value="@s">@Status(s)</option>}</select></label><label>توضیح<input name="Message" maxlength="8000" /></label><button>ثبت وضعیت</button></form>
<form method="post" asp-page-handler="Claim"><input type="hidden" name="Version" value="@item.Version" /><label>رول<select name="RoleId">@foreach(var r in catalog.Roles.Where(x=>x.IsEnabled)){<option value="@r.Id">@r.Name</option>}</select></label><label>برنچ<input name="Branch" maxlength="250" dir="ltr" /></label><button>برداشتن کار</button></form>
<form method="post" asp-page-handler="Estimate"><input type="hidden" name="Version" value="@item.Version" /><label>برآورد زمان؛ خالی برای حذف<input name="EstimateValue" type="number" min="0.01" step="0.01" value="@(item.EstimatedSeconds.HasValue ? (item.EstimatedSeconds.Value / 60m).ToString("0.################",System.Globalization.CultureInfo.InvariantCulture) : null)" /></label><label>واحد برآورد<select name="EstimateUnit"><option value="minutes">دقیقه</option><option value="hours">ساعت</option><option value="seconds">ثانیه</option></select></label><button>ثبت برآورد زمان</button></form>
<form method="post" asp-page-handler="TokenEstimate"><input type="hidden" name="Version" value="@item.Version" /><label>برآورد توکن؛ خالی برای حذف<input name="EstimatedTokens" type="number" min="1" step="1" value="@item.EstimatedTokens" /></label><button>ثبت برآورد توکن</button></form>
<form method="post" asp-page-handler="@(item.IsTracking?"StopTime":"StartTime")"><input type="hidden" name="Version" value="@item.Version" /><p>زمان‌سنج: @(item.IsTracking?"فعال":"متوقف")</p><button>@(item.IsTracking?"توقف زمان‌سنج":"شروع زمان‌سنج")</button></form>
@if(item.IsArchived || item.Status is "Blocked" or "Done"){<form method="post" asp-page-handler="@(item.IsArchived?"Restore":"Archive")"><input type="hidden" name="Version" value="@item.Version" /><button class="secondary">@(item.IsArchived?"بازگردانی از بایگانی":"بایگانی کار")</button></form>}
</div></section>
<section class="panel" id="token-reports"><h2>گزارش مصرف توکن</h2><p class="small">ورودی و خروجی جمع می‌شوند؛ cache جزئی از ورودی و reasoning جزئی از خروجی است. فیلد نامعلوم را خالی بگذارید؛ صفر یعنی مصرف صفرِ گزارش‌شده. گزارش تخمینی اجرا در مصرف شمرده نمی‌شود.</p>
@if(item.TokenMeter is {} meter){<p class="small">@meter.CompleteReportCount گزارش کامل از @meter.ReportCount گزارش مصرف؛ ورود: @(meter.InputTokens?.ToString("N0")??"نامعلوم") · خروج: @(meter.OutputTokens?.ToString("N0")??"نامعلوم") · cache: @(meter.CachedInputTokens?.ToString("N0")??"نامعلوم") · reasoning: @(meter.ReasoningTokens?.ToString("N0")??"نامعلوم")</p>}
@if(details.TokenUsage?.Count > 0){<div class="table-scroll"><table><thead><tr><th>منبع</th><th>مدل</th><th>ورودی</th><th>خروجی</th><th>cache / reasoning</th><th>مرجع و زمان</th></tr></thead><tbody>@foreach(var report in details.TokenUsage){<tr><td>@report.Source @if(report.RunId is {} runId){<a asp-page="/Run" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@runId">اجرا</a>}</td><td>@report.Provider / @report.Model</td><td>@(report.InputTokens?.ToString("N0")??"نامعلوم")</td><td>@(report.OutputTokens?.ToString("N0")??"نامعلوم")</td><td>@(report.CachedInputTokens?.ToString("N0")??"نامعلوم") / @(report.ReasoningTokens?.ToString("N0")??"نامعلوم")</td><td>@report.Reference <time dir="ltr">@report.RecordedAtUtc.ToString("u")</time></td></tr>}</tbody></table></div>}else{<p>هنوز گزارشی ثبت نشده است؛ مصرف توکن نامعلوم است.</p>}
@if(!item.IsArchived && item.OwnerAgentId is not null && !(item.OwnerAgentId.StartsWith("neo-run:",StringComparison.Ordinal))){<details><summary>ثبت گزارش دستی برای کار بدون اجرا</summary><p class="small">فقط شمارندهٔ واقعیِ ارائه‌دهنده را وارد کنید. اگر گزارش به اجرای ایجنت تعلق دارد، آن را از API اجرا ثبت کنید؛ ثبت در هر دو مسیر مصرف را دو بار می‌شمارد.</p><form method="post" asp-page-handler="TokenUsage" data-draft-key="token-usage-@item.Id" class="form-grid"><input type="hidden" name="Version" value="@item.Version" /><input type="hidden" name="UsageRequestId" value="@Model.UsageRequestId" /><label>ارائه‌دهنده<input name="UsageProvider" required maxlength="80" /></label><label>مدل<input name="UsageModel" maxlength="200" /></label><label class="wide">مرجع گزارش ارائه‌دهنده<input name="UsageReference" required maxlength="500" /></label><label>توکن ورودی<input name="InputTokens" type="number" min="0" step="1" /></label><label>توکن خروجی<input name="OutputTokens" type="number" min="0" step="1" /></label><label>ورودی cache<input name="CachedInputTokens" type="number" min="0" step="1" /></label><label>توکن reasoning<input name="ReasoningTokens" type="number" min="0" step="1" /></label><button>ثبت گزارش مصرف</button></form></details>}
</section>
<section class="panel" id="children"><h2>زیرتسک‌ها و وابستگی‌ها</h2>
@if(item.ParentWorkItemId is {} parent){<p>کار والد: <a asp-page="/Item" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@parent">مشاهده والد</a></p>}
@if(details.Children.Count==0){<p>زیرتسکی ثبت نشده است.</p>}else{<ul>@foreach(var child in details.Children){<li><a asp-page="/Item" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@child.Id">@child.Key — @child.Title</a> · @Status(child.Status)</li>}</ul>}
<h3>وابستگی‌ها</h3><ul>@foreach(var dep in details.Dependencies){<li><a asp-page="/Item" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@dep">@dep</a></li>}</ul>
<form method="post" asp-page-handler="Dependency" class="inline-form"><input type="hidden" name="Version" value="@item.Version" /><label>شناسه کار پیش‌نیاز<input name="DependencyId" required dir="ltr" /></label><button>افزودن وابستگی</button></form></section>
<section class="panel" id="runs"><h2>اجراهای ایجنت</h2><p class="muted">fake فقط شبیه‌سازی است. پروفایل http.name به Harness پیکربندی‌شده همان فضای کاری متصل می‌شود؛ ارسال اطلاعات کار و اجرای بیرونی نیاز به اجازه صریح زیر دارد.</p>
<ul>@foreach(var run in Model.Runs){<li><a asp-page="/Run" asp-route-organizationId="@Model.OrganizationId" asp-route-workspaceId="@Model.WorkspaceId" asp-route-id="@run.Run.Id">اجرای @run.Run.Hop · @Model.Role(run.Run.RoleId)</a> — @run.Run.Status / @run.Run.Decision</li>}</ul>
@foreach(var flow in catalog.Workflows.Where(x=>x.ProjectId==item.ProjectId && x.IsEnabled)){
<details><summary>فلو @flow.Name</summary><div class="forms">
<form method="post" asp-page-handler="Run"><input type="hidden" name="Version" value="@item.Version" /><input type="hidden" name="WorkflowId" value="@flow.Id" /><input type="hidden" name="WorkflowVersion" value="@flow.Version" /><input type="hidden" name="RequestId" value="@Model.RequestId" />
<label>رول آغاز<select name="RoleId">@foreach(var r in catalog.Roles.Where(x=>x.IsEnabled)){<option value="@r.Id">@r.Name</option>}</select></label><label>ایجنت<select name="AgentProfileId"><option value="">انتخاب خودکار در صورت یکتا بودن</option>@foreach(var a in catalog.Agents.Where(x=>x.IsEnabled)){<option value="@a.Id">@a.Name · @a.Provider</option>}</select></label>
<label>برنچ<input name="Branch" maxlength="250" /></label><label>نتیجه فقط برای شبیه‌سازی<select name="SimulationOutcome"><option>Succeeded</option><option>Failed</option><option>NeedsInput</option></select></label><label class="check"><input name="AllowExternalExecution" type="checkbox" value="true" />ارسال شرح، سابقه و شواهد کار به Harness و اجرای بیرونی در این زنجیره را اجازه می‌دهم.</label><button>درخواست اجرا</button></form>
<form method="post" asp-page-handler="Preview"><input type="hidden" name="WorkflowId" value="@flow.Id" /><label>انتقال<select name="TransitionId">@foreach(var t in flow.Transitions){<option value="@t.Id">@t.Key</option>}</select></label><button class="secondary">بررسی شروط، بدون اجرا</button></form>
<form method="post" asp-page-handler="Approve"><input type="hidden" name="WorkflowId" value="@flow.Id" /><input type="hidden" name="WorkflowVersion" value="@flow.Version" /><input type="hidden" name="Version" value="@item.Version" /><label>انتقال<select name="TransitionId">@foreach(var t in flow.Transitions){<option value="@t.Id">@t.Key</option>}</select></label><label>تصمیم<select name="Approved"><option value="true">تأیید</option><option value="false">رد</option></select></label><label>علت<input name="Message" required maxlength="8000" /></label><button>ثبت تصمیم بازبین مستقل</button></form>
</div></details>}
@if(Model.Plan is {} plan){<div class="notice" role="status">شروط انتقال: @(plan.GatesSatisfied?"برقرار":"ناقص")<ul>@foreach(var condition in plan.UnmetConditions){<li>@condition</li>}</ul></div>}
</section>
<section class="panel"><h2>شواهد و یادداشت</h2><div class="forms">
<form method="post" asp-page-handler="Log"><input type="hidden" name="Version" value="@item.Version" /><label>یادداشت جدید<textarea name="Message" rows="4" maxlength="8000" required></textarea></label><button>افزودن به سابقه</button></form>
<form method="post" asp-page-handler="Evidence"><input type="hidden" name="Version" value="@item.Version" /><label>نوع<select name="Kind"><option>Commit</option><option>Test</option><option>Artifact</option></select></label><label>مرجع<input name="Reference" required maxlength="2000" /></label><label>نتیجه<select name="Outcome"><option>NotApplicable</option><option>Passed</option><option>Failed</option><option>Skipped</option></select></label><label>SHA کامیت مرتبط<input name="CommitSha" dir="ltr" /></label><label>توضیحات<textarea name="Message" rows="2"></textarea></label><button>ثبت شاهد واقعی</button></form>
</div><ul>@foreach(var e in details.Evidence){<li><strong>@e.Kind / @e.Outcome</strong> · @e.Reference <span dir="ltr">@e.CommitSha</span><p class="prose">@e.Details</p></li>}</ul></section>
<section class="panel" id="history"><h2>سابقه کار</h2><ol class="timeline">@foreach(var log in details.Logs.OrderByDescending(x=>x.CreatedAtUtc)){<li><div class="small"><time dir="ltr">@log.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time> · @log.Kind · @log.AgentId / @log.ChatId</div><div class="prose">@log.Message</div></li>}</ol>
<h3>بازه‌های زمان</h3><ul>@foreach(var time in details.TimeEntries){<li><span dir="ltr">@time.StartedAtUtc.ToString("u") → @(time.EndedAtUtc?.ToString("u")??"running")</span> · @Time(time.DurationSeconds)</li>}</ul>
<h3>تصمیم‌های بازبینی</h3><ul>@foreach(var approval in Model.Approvals){<li>@(approval.Approved?"تأیید":"رد") · @approval.ReviewerAgentId · <span dir="ltr">@approval.CreatedAtUtc.ToString("u")</span><p class="prose">@approval.Reason</p></li>}</ul></section>
}

@model Neo.AgentOrchestration.Web.Pages.TransitionEditor
@{var t=Model.Transition;}
<form method="post" asp-page-handler="Transition" class="form-grid"><input type="hidden" name="Id" value="@Model.Flow.Id" /><input type="hidden" name="Version" value="@Model.Flow.Version" />
<label>کلید انتقال<input name="Key" value="@t?.Key" required /></label><label>رول مبدأ<select name="FromRoleId">@foreach(var r in Model.Catalog.Roles){<option value="@r.Id" selected="@(t?.FromRoleId==r.Id)">@r.Name</option>}</select></label>
<label>وضعیت مبدأ<select name="FromStatus"><option selected="@(t?.FromStatus=="Review")">Review</option><option selected="@(t?.FromStatus=="Blocked")">Blocked</option></select></label>
<label>رول مقصد<select name="ToRoleId"><option value="">بدون رول (برای Done)</option>@foreach(var r in Model.Catalog.Roles){<option value="@r.Id" selected="@(t?.ToRoleId==r.Id)">@r.Name</option>}</select></label>
<label>وضعیت مقصد<select name="ToStatus"><option selected="@(t?.ToStatus=="Ready")">Ready</option><option selected="@(t?.ToStatus=="Done")">Done</option></select></label><label>Artifact لازم<input name="RequiredArtifact" value="@t?.RequiredArtifact" /></label>
<label class="check"><input type="checkbox" name="RequireCommit" value="true" checked="@(t?.RequireCommit??false)" />کامیت لازم است</label><label class="check"><input type="checkbox" name="RequirePassingTests" value="true" checked="@(t?.RequirePassingTests??false)" />تست موفق لازم است</label><label class="check"><input type="checkbox" name="RequireApproval" value="true" checked="@(t?.RequireApproval??false)" />تأیید مستقل لازم است</label><label class="check"><input type="checkbox" name="Enabled" value="true" checked="@(t?.IsEnabled??true)" />انتقال فعال است</label><div class="wide"><button>ذخیره انتقال</button></div></form>

		<PackageVersion Include="Microsoft.OpenApi.Readers" Version="1.6.13" />
		<PackageVersion Include="Microsoft.Playwright" Version="1.39.0" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />

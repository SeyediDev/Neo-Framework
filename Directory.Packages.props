<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<NoWarn>$(NoWarn);NU1902;NU1903;NU1510</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<DotNetVersion>10.0.8</DotNetVersion>
		<EfVersion>10.0.8</EfVersion>
		<Version>10.0.8</Version>
	</PropertyGroup>

	<ItemGroup>
		<!-- A -->
		<PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
		<PackageVersion Include="Asp.Versioning.Mvc" Version="10.0.0" />
		<PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />

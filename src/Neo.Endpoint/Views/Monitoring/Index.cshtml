                el.style.pointerEvents = 'none';
            });
            
            // بستن منو اگر باز است (با استفاده از Mmenu API)
            if (window.mmenuInstance) {
                try {
                    window.mmenuInstance.close();
                } catch(e) {
                    // اگر mmenuInstance وجود نداشت یا خطا داد، نادیده بگیر
                }
            }
            
            // همچنین چک کردن تمام Mmenu instances که ممکن است در DOM وجود داشته باشند
            try {
                // اگر Mmenu library لود شده باشد
                if (typeof Mmenu !== 'undefined') {
                    // پیدا کردن تمام instances
                    var allMmenus = document.querySelectorAll('[data-mm-menu]');
                    allMmenus.forEach(function(menuEl) {
                        try {
                            var instance = menuEl.mmMenu;
                            if (instance && typeof instance.close === 'function') {
                                instance.close();
                            }
                        } catch(e) {
                            // نادیده گرفتن خطا
                        }
                    });
                }
            } catch(e) {
                // نادیده گرفتن خطا
            }
            
            // حذف کلاس‌های opened از body و wrapper
            document.body.classList.remove('mm-wrapper--opened', 'mm-wrapper--position-right');
            document.documentElement.classList.remove('mm-wrapper--opened', 'mm-wrapper--position-right');
            
            // هاید کردن hamburger menu icon
            document.querySelectorAll('.modern-hamburger-menu, .hamburger-link, .hamburger-icon').forEach(function(el) {
                el.style.display = 'none';
                el.style.visibility = 'hidden';
                el.style.opacity = '0';
                el.style.pointerEvents = 'none';
            });
        }
        
        // اجرای فوری
        hideMenu2();
        
        // اجرا بعد از DOMContentLoaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', hideMenu2);
        }
        
        // اجرا بعد از window.load
        window.addEventListener('load', hideMenu2);
        
        // اجرا با تاخیر برای اطمینان
        setTimeout(hideMenu2, 100);
        setTimeout(hideMenu2, 500);
        setTimeout(hideMenu2, 1000);
        setTimeout(hideMenu2, 2000);
        
        // اضافه کردن event listener برای بستن منو با کلیک روی overlay
        document.addEventListener('click', function(e) {
            var target = e.target;
            // اگر روی overlay کلیک شد، منو را ببند
            if (target && (target.classList.contains('mm-wrapper__blocker') || 
                target.classList.contains('mm-menu') ||
                (target.closest && target.closest('.mm-wrapper__blocker')))) {
                e.preventDefault();
                e.stopPropagation();
                hideMenu2();
            }
        }, true); // استفاده از capture phase برای اطمینان
        
        // بستن منو با کلید ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' || e.keyCode === 27) {
                hideMenu2();
            }
        });
        
        // جلوگیری از باز شدن منو با کلیک روی hamburger icon
        document.addEventListener('click', function(e) {
            var target = e.target;
            if (target && (target.closest && target.closest('.hamburger-link') || 
                target.closest && target.closest('.modern-hamburger-menu'))) {
                e.preventDefault();
                e.stopPropagation();
                hideMenu2();
                return false;
            }
        }, true);
        
        // چک کردن مداوم برای بستن منو (در صورت باز شدن)
        setInterval(function() {
            // چک کردن وجود overlay/backdrop
            var blocker = document.querySelector('.mm-wrapper__blocker');
            var openedMenu = document.querySelector('.mm-menu--opened');
            var openedWrapper = document.querySelector('.mm-wrapper--opened');
            
            if (blocker || openedMenu || openedWrapper) {
                hideMenu2();
            }
            
            // چک کردن کلاس‌های opened در body و html
            if (document.body.classList.contains('mm-wrapper--opened') || 
                document.documentElement.classList.contains('mm-wrapper--opened')) {
                hideMenu2();
            }
        }, 100); // چک کردن هر 100 میلی‌ثانیه
        
        // استفاده از MutationObserver برای رصد تغییرات DOM
        var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.addedNodes && mutation.addedNodes.length > 0) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1) { // Element node
                            if (node.id === 'menu2' || (node.querySelector && node.querySelector('#menu2'))) {
                                hideMenu2();
                            }
                            // همچنین چک کردن overlay/backdrop Mmenu
                            if (node.classList && (node.classList.contains('mm-wrapper__blocker') || 
                                node.classList.contains('mm-menu') || 
                                node.classList.contains('mm-menu--opened'))) {
                                hideMenu2();
                            }
                        }
                    });
                }
                // چک کردن تغییرات در کلاس‌ها (مثلاً وقتی منو باز می‌شود)
                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                    var target = mutation.target;
                    if (target.classList && (target.classList.contains('mm-wrapper--opened') || 
                        target.classList.contains('mm-menu--opened'))) {
                        hideMenu2();
                    }
                }
            });
        });
        
        // شروع رصد تغییرات DOM
        observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class']
        });
        
        // همچنین رصد تغییرات در documentElement
        observer.observe(document.documentElement, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class']
        });
        
        // حذف script های layout.min.js (قبل از لود شدن)
        function removeLayoutScripts() {
            // حذف script های layout.min.js
            document.querySelectorAll('script[src*="layout.min.js"], script[src*="layout"], script[src*="Layout"]').forEach(function(script) {
                script.remove();
            });
            
            // حذف BrowserLink scripts
            document.querySelectorAll('script[src*="browserLink"], script[src*="BrowserLink"]').forEach(function(script) {
                script.remove();
            });
            
            // حذف aspnetcore-browser-refresh scripts
            document.querySelectorAll('script[src*="aspnetcore-browser-refresh"], script[src*="browser-refresh"]').forEach(function(script) {
                script.remove();
            });
            
            // حذف عناصر BrowserLink از DOM
            document.querySelectorAll('[id*="browserLink"], [class*="browserLink"], [id*="BrowserLink"], [class*="BrowserLink"]').forEach(function(el) {
                el.remove();
            });
            
            // جلوگیری از لود شدن BrowserLink در آینده
            if (window.browserLink) {
                delete window.browserLink;
            }
            if (window.BrowserLink) {
                delete window.BrowserLink;
            }
            
            // جلوگیری از ایجاد BrowserLink
            Object.defineProperty(window, 'browserLink', {
                value: undefined,
                writable: false,
                configurable: false
            });
        }
        
        // اجرای فوری
        removeLayoutScripts();
        
        // اجرا بعد از DOMContentLoaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', removeLayoutScripts);
        }
        
        // اجرا بعد از window.load
        window.addEventListener('load', removeLayoutScripts);
        
        // اجرا با تاخیر برای اطمینان
        setTimeout(removeLayoutScripts, 50);
        setTimeout(removeLayoutScripts, 100);
        setTimeout(removeLayoutScripts, 500);
        
        // استفاده از MutationObserver برای رصد و حذف script های جدید
        var scriptObserver = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.addedNodes && mutation.addedNodes.length > 0) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1) { // Element node
                            if (node.tagName === 'SCRIPT') {
                                var src = node.src || node.getAttribute('src') || '';
                                if (src.includes('layout.min.js') || src.includes('browserLink') || src.includes('aspnetcore-browser-refresh')) {
                                    node.remove();
                                }
                            }
                        }
                    });
                }
            });
        });
        
        // شروع رصد تغییرات DOM برای script ها
        scriptObserver.observe(document.head, {
            childList: true,
            subtree: true
        });
        scriptObserver.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        // جلوگیری از لود شدن BrowserLink در آینده
        if (window.browserLink) {
            delete window.browserLink;
        }
        
        // جلوگیری از console.log های BrowserLink
        var originalLog = console.log;
        console.log = function() {
            var args = Array.prototype.slice.call(arguments);
            if (args.length > 0 && typeof args[0] === 'string' && 
                (args[0].includes('browserLink') || args[0].includes('layout.min.js') || 
                 args[0].includes('JQMIGRATE') )) {
                return; // لاگ نکن
            }
            originalLog.apply(console, args);
        };
    })();
</script>

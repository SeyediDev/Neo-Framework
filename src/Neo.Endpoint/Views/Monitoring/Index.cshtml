<script>
    // Monitoring Dashboard JavaScript
    (function() {
        const API_BASE = '/api/monitoring';
        let currentLogLevel = 'all';
        let isPaused = false;
        let refreshIntervals = [];
        let currentDrillDownMetric = null;
        
        
        // Metric Drill-Down functions
        window.showMetricDrillDown = async function(index) {
            const metric = window.metricsData && window.metricsData[index];
            if (!metric) return;
            
            currentDrillDownMetric = getProp(metric, 'Name');
            const stats = getProp(metric, 'Stats') || {};
            
            // Set modal title
            document.getElementById('drilldown-title').textContent = currentDrillDownMetric;
            
            // Set stats
            const unit = getProp(metric, 'Unit') || '';
            document.getElementById('dd-current').textContent = formatStatValue(getProp(stats, 'CurrentValue'), unit);
            document.getElementById('dd-avg').textContent = formatStatValue(getProp(stats, 'AvgValue'), unit);
            document.getElementById('dd-min').textContent = formatStatValue(getProp(stats, 'MinValue'), unit);
            document.getElementById('dd-max').textContent = formatStatValue(getProp(stats, 'MaxValue'), unit);
            document.getElementById('dd-sum').textContent = formatStatValue(getProp(stats, 'SumValue'), unit);
            document.getElementById('dd-count').textContent = (getProp(stats, 'Count') || 0).toLocaleString();
            
            // Set info
            document.getElementById('dd-type').textContent = getProp(metric, 'Type') || '-';
            document.getElementById('dd-unit').textContent = unit || 'بدون واحد';
            document.getElementById('dd-description').textContent = getProp(metric, 'Description') || '-';
            
            // Show modal
            document.getElementById('metric-drilldown-modal').style.display = 'flex';
            
            // Load chart with default time range
            loadDrillDownChart(5);
        };
        
        window.closeMetricDrillDown = function() {
            document.getElementById('metric-drilldown-modal').style.display = 'none';
            currentDrillDownMetric = null;
        };
        
        window.loadDrillDownChart = async function(minutes) {
            if (!currentDrillDownMetric) return;
            
            // Update button states
            document.querySelectorAll('.dd-time-btn').forEach(btn => {
                btn.classList.toggle('active', parseInt(btn.dataset.minutes) === minutes);
            });
            
            const loading = document.getElementById('drilldown-chart-loading');
            loading.style.display = 'block';
            
            try {
                const from = new Date(Date.now() - minutes * 60 * 1000).toISOString();
                const response = await fetch(`${API_BASE}/metrics/${encodeURIComponent(currentDrillDownMetric)}/timeseries?from=${from}`);
                
                if (!response.ok) throw new Error('Failed to fetch');
                const data = await response.json();
                
                const dataPoints = getProp(data, 'DataPoints') || [];
                
                if (dataPoints.length < 2) {
                    loading.textContent = 'داده کافی برای نمایش نمودار وجود ندارد';
                    document.querySelector('.dd-chart-line').setAttribute('d', '');
                    document.querySelector('.dd-chart-area').setAttribute('d', '');
                    return;
                }
                
                loading.style.display = 'none';
                
                // Draw chart
                const width = 600;
                const height = 200;
                const padding = 20;
                
                const values = dataPoints.map(p => getProp(p, 'Value') || 0);
                const maxVal = Math.max(...values, 1);
                const minVal = Math.min(...values, 0);
                const range = maxVal - minVal || 1;
                
                const points = dataPoints.map((p, i) => {
                    const x = padding + (i / (dataPoints.length - 1)) * (width - padding * 2);
                    const y = height - padding - ((getProp(p, 'Value') - minVal) / range) * (height - padding * 2);
                    return { x, y };
                });
                
                const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
                const areaPath = linePath + ` L ${points[points.length-1].x} ${height - padding} L ${points[0].x} ${height - padding} Z`;
                
                document.querySelector('.dd-chart-line').setAttribute('d', linePath);
                document.querySelector('.dd-chart-area').setAttribute('d', areaPath);
                
            } catch (error) {
                console.error('Error loading drill-down chart:', error);
                loading.textContent = 'خطا در بارگذاری نمودار';
            }
        };
        
        function formatStatValue(value, unit) {
            if (value === null || value === undefined) return '--';
            const formatted = typeof value === 'number' ? value.toFixed(2) : value;
            return unit ? `${formatted} ${unit}` : formatted;
        }
        
        // Close modal on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeMetricDrillDown();
            }
        });
        
        // Close modal on backdrop click
        document.getElementById('metric-drilldown-modal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeMetricDrillDown();
            }
        });
        
        // Tab switching
        window.switchTab = function(tabName) {
            // Update tab buttons
            document.querySelectorAll('.data-tab').forEach(tab => {
                tab.classList.toggle('active', tab.dataset.tab === tabName);
            });
            // Update tab content
            document.querySelectorAll('.data-tab-content').forEach(content => {
                content.classList.toggle('active', content.id === 'tab-' + tabName);
            });
        };
        
        // ===== Chart Data & Functions =====
        let currentTimeRange = 5; // minutes
        const chartData = {
            cpu: [],
            memory: [],
            requests: [],
            errors: []
        };
        const maxDataPoints = 60;
        
        // Time range selector
        window.setTimeRange = function(minutes) {
            currentTimeRange = minutes;
            document.querySelectorAll('.time-range-btn').forEach(btn => {
                btn.classList.toggle('active', parseInt(btn.dataset.range) === minutes);
            });
            // Clear old data and fetch new
            Object.keys(chartData).forEach(key => chartData[key] = []);
            fetchChartsData();
        };
        
        // Draw SVG line chart
        function drawLineChart(svgId, data, maxValue) {
            const svg = document.getElementById(svgId);
            if (!svg) {
                console.warn('SVG element not found:', svgId);
                return;
            }
            
            if (!data || data.length === 0) {
                // Clear chart if no data
                const areaEl = svg.querySelector('.chart-area');
                const lineEl = svg.querySelector('.chart-line');
                if (areaEl) areaEl.setAttribute('d', '');
                if (lineEl) lineEl.setAttribute('d', '');
                return;
            }
            
            const width = 400;
            const height = 120;
            const padding = 5;
            
            // Normalize data
            const max = maxValue || Math.max(...data.map(d => d.value || 0), 1);
            
            if (max <= 0) {
                // Clear chart if invalid max value
                const areaEl = svg.querySelector('.chart-area');
                const lineEl = svg.querySelector('.chart-line');
                if (areaEl) areaEl.setAttribute('d', '');
                if (lineEl) lineEl.setAttribute('d', '');
                return;
            }
            
            // Create points
            const points = data.map((d, i) => {
                const value = d.value || 0;
                const x = padding + (i / (data.length - 1 || 1)) * (width - padding * 2);
                const y = height - padding - (value / max) * (height - padding * 2);
                return { x, y };
            });
            
            if (points.length < 2) {
                // Need at least 2 points to draw a line
                const areaEl = svg.querySelector('.chart-area');
                const lineEl = svg.querySelector('.chart-line');
                if (areaEl) areaEl.setAttribute('d', '');
                if (lineEl) lineEl.setAttribute('d', '');
                return;
            }
            
            // Create SVG path
            const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(' ');
            const areaPath = linePath + ` L ${points[points.length-1].x.toFixed(2)} ${height} L ${points[0].x.toFixed(2)} ${height} Z`;
            
            // Update SVG elements
            const areaEl = svg.querySelector('.chart-area');
            const lineEl = svg.querySelector('.chart-line');
            
            if (areaEl) {
                areaEl.setAttribute('d', areaPath);
            } else {
                console.warn('Chart area element not found in:', svgId);
            }
            
            if (lineEl) {
                lineEl.setAttribute('d', linePath);
            } else {
                console.warn('Chart line element not found in:', svgId);
            }
        }
        
        // Record new data point
        function recordDataPoint(type, value) {
            const now = Date.now();
            chartData[type].push({ time: now, value: value || 0 });
            
            // Keep only data within time range
            const cutoff = now - currentTimeRange * 60 * 1000;
            chartData[type] = chartData[type].filter(d => d.time >= cutoff);
            
            // Limit max points
            if (chartData[type].length > maxDataPoints) {
                chartData[type] = chartData[type].slice(-maxDataPoints);
            }
        }
        
        // Update charts from current data
        function updateCharts() {
            // CPU chart
            const cpuEl = document.getElementById('cpu-chart-value');
            if (chartData.cpu.length > 0) {
                const lastCpu = chartData.cpu[chartData.cpu.length - 1].value;
                if (cpuEl) cpuEl.textContent = lastCpu.toFixed(1) + '%';
                drawLineChart('cpu-chart', chartData.cpu, 100);
            } else if (cpuEl) {
                cpuEl.textContent = '--%';
            }
            
            // Memory chart
            const memEl = document.getElementById('memory-chart-value');
            if (chartData.memory.length > 0) {
                const lastMem = chartData.memory[chartData.memory.length - 1].value;
                if (memEl) memEl.textContent = lastMem.toFixed(1) + '%';
                drawLineChart('memory-chart', chartData.memory, 100);
            } else if (memEl) {
                memEl.textContent = '--%';
            }
            
            // Requests chart
            const reqEl = document.getElementById('requests-chart-value');
            if (chartData.requests.length > 0) {
                const lastReq = chartData.requests[chartData.requests.length - 1].value;
                if (reqEl) reqEl.textContent = lastReq.toFixed(2);
                drawLineChart('requests-chart', chartData.requests, null);
            } else if (reqEl) {
                reqEl.textContent = '--';
            }
            
            // Errors chart
            const errEl = document.getElementById('errors-chart-value');
            if (chartData.errors.length > 0) {
                const lastErr = chartData.errors[chartData.errors.length - 1].value;
                if (errEl) errEl.textContent = lastErr.toFixed(1) + '%';
                drawLineChart('errors-chart', chartData.errors, 100);
            } else if (errEl) {
                errEl.textContent = '--%';
            }
        }
        
        // Fetch chart data from API
        async function fetchChartsData() {
            try {
                const response = await fetch(`${API_BASE}/dashboard`);
                if (!response.ok) return;
                const data = await response.json();
                
                const system = getProp(data, 'System') || {};
                const app = getProp(data, 'Application') || {};
                
                const cpuVal = getProp(system, 'CpuUsagePercent') || 0;
                const memVal = getProp(system, 'MemoryUsagePercent') || 0;
                const reqVal = getProp(app, 'RequestsPerSecond') || 0;
                const successRate = getProp(app, 'SuccessRate') || 100;
                const errorRate = 100 - successRate;
                
                recordDataPoint('cpu', cpuVal);
                recordDataPoint('memory', memVal);
                recordDataPoint('requests', reqVal);
                recordDataPoint('errors', errorRate);
                
                updateCharts();
            } catch (error) {
                console.error('Error fetching chart data:', error);
            }
        }
        
        // Pause/Resume toggle
        window.togglePause = function() {
            isPaused = !isPaused;
            const btn = document.getElementById('btn-pause');
            const pauseIcon = document.getElementById('pause-icon');
            const playIcon = document.getElementById('play-icon');
            const pauseText = document.getElementById('pause-text');
            const refreshDot = document.getElementById('refresh-dot');
            const refreshStatus = document.getElementById('refresh-status');
            
            if (isPaused) {
                btn.classList.add('paused');

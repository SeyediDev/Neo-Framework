                btn.classList.remove('paused');
                pauseIcon.style.display = 'block';
                playIcon.style.display = 'none';
                pauseText.textContent = 'توقف';
                refreshDot.classList.remove('paused');
                refreshStatus.textContent = 'بروزرسانی خودکار';
                // Immediately refresh when resuming
                fetchDashboard();
                fetchHealth();
                fetchLogs(currentLogLevel);
                fetchCollectedMetrics();
                fetchTraces();
            }
        };
        
        // Helper to get property (handles both PascalCase and camelCase)
        function getProp(obj, ...keys) {
            for (const key of keys) {
                const camel = key.charAt(0).toLowerCase() + key.slice(1);
                const pascal = key.charAt(0).toUpperCase() + key.slice(1);
                if (obj[camel] !== undefined) return obj[camel];
                if (obj[pascal] !== undefined) return obj[pascal];
            }
            return null;
        }
        
        // Format bytes to human readable
        function formatBytes(bytes) {
            if (!bytes || bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }
        
        // Format duration
        function formatDuration(ms) {
            if (!ms || ms < 1) return '<1 ms';
            if (ms < 1000) return ms.toFixed(0) + ' ms';
            return (ms / 1000).toFixed(2) + ' s';
        }
        
        // Format time
        function formatTime(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        
        // Get log level badge
        function getLogLevelBadge(level) {
            const levels = {
                0: { class: 'trace', text: 'Trace' },
                1: { class: 'debug', text: 'Debug' },
                2: { class: 'info', text: 'Info' },
                3: { class: 'warning', text: 'Warning' },
                4: { class: 'error', text: 'Error' },
                5: { class: 'critical', text: 'Critical' }
            };
            const l = levels[level] || { class: 'info', text: 'Info' };
            return `<span class="log-level ${l.class}">${l.text}</span>`;
        }
        
        // Update health status
        function updateHealthStatus(status) {
            const badge = document.getElementById('health-status');
            if (!badge) return;
            badge.className = 'health-badge health-' + status.toLowerCase();
            const text = { 'healthy': 'سالم', 'warning': 'هشدار', 'critical': 'بحرانی' };
            badge.innerHTML = `<span class="health-dot"></span><span>${text[status.toLowerCase()] || status}</span>`;
        }
        
        // Fetch dashboard data
        async function fetchDashboard() {
            try {
                const response = await fetch(`${API_BASE}/dashboard`);
                if (!response.ok) throw new Error('Failed to fetch: ' + response.status);
                const data = await response.json();
                
                // Get system and application objects (handle both cases)
                const system = getProp(data, 'System') || data.System || data.system || {};
                const application = getProp(data, 'Application') || data.Application || data.application || {};
                
                // Update system metrics
                const cpuVal = getProp(system, 'CpuUsagePercent');
                const memPercent = getProp(system, 'MemoryUsagePercent');
                const memUsed = getProp(system, 'MemoryUsedBytes');
                const memTotal = getProp(system, 'MemoryTotalBytes');
                
                document.getElementById('cpu-value').textContent = cpuVal !== null ? cpuVal.toFixed(1) + '%' : '--';
                document.getElementById('memory-value').textContent = memPercent !== null ? memPercent.toFixed(1) + '%' : '--';
                document.getElementById('memory-detail').textContent = 
                    memUsed && memTotal ? `${formatBytes(memUsed)} / ${formatBytes(memTotal)}` : '--';
                
                // Update application metrics
                const reqPerSec = getProp(application, 'RequestsPerSecond');
                const totalReq = getProp(application, 'TotalRequests');
                const avgResp = getProp(application, 'AverageResponseTimeMs');
                const activeReq = getProp(application, 'ActiveRequests');
                const successRate = getProp(application, 'SuccessRate');
                const failedReq = getProp(application, 'FailedRequests');
                
                document.getElementById('requests-value').textContent = reqPerSec !== null ? reqPerSec.toFixed(2) : '--';
                document.getElementById('requests-detail').textContent = 
                    totalReq !== null ? `کل: ${totalReq.toLocaleString('fa-IR')}` : '--';
                document.getElementById('response-value').textContent = formatDuration(avgResp);
                document.getElementById('active-value').textContent = activeReq !== null ? activeReq : '--';
                document.getElementById('error-value').textContent = successRate !== null ? successRate.toFixed(1) + '%' : '--';
                document.getElementById('error-detail').textContent = 
                    failedReq !== null ? `خطا: ${failedReq.toLocaleString('fa-IR')}` : '--';
                
            } catch (error) {
                console.error('Error fetching dashboard:', error);
            }
        }
        
        // Fetch health status
        async function fetchHealth() {
            try {
                const response = await fetch(`${API_BASE}/dashboard/health`);
                if (!response.ok) throw new Error('Failed to fetch');
                const data = await response.json();
                const status = getProp(data, 'Status') || 'Healthy';
                updateHealthStatus(status);
            } catch (error) {
                console.error('Error fetching health:', error);
            }
        }
        
        // Fetch logs
        async function fetchLogs(level) {
            try {
                let url = `${API_BASE}/logs/recent?limit=50`;
                if (level && level !== 'all') {
                    // Map string log levels to numeric values
                    const levelMap = {
                        'trace': 0,
                        'debug': 1,
                        'info': 2,
                        'warning': 3,
                        'error': 4,
                        'critical': 5
                    };
                    const numericLevel = levelMap[level.toLowerCase()] !== undefined 
                        ? levelMap[level.toLowerCase()] 
                        : level; // If already numeric, use as-is
                    url += `&minLevel=${numericLevel}`;
                }
                
                // Add correlation ID filter
                const correlationId = document.getElementById('log-correlation-filter')?.value?.trim();
                if (correlationId) {
                    url += `&correlationId=${encodeURIComponent(correlationId)}`;
                }
                
                // Add source filter
                const sourceFilter = document.getElementById('log-source-filter')?.value?.trim();
                if (sourceFilter) {
                    url += `&source=${encodeURIComponent(sourceFilter)}`;
                }
                
                // Add text search filter
                const textFilter = document.getElementById('log-text-filter')?.value?.trim();
                if (textFilter) {
                    url += `&textSearch=${encodeURIComponent(textFilter)}`;
                }
                
                const response = await fetch(url);
                if (!response.ok) throw new Error('Failed to fetch');
                const logs = await response.json();
                
                const tbody = document.getElementById('logs-body');
                
                // Extract unique sources and populate combobox
                const uniqueSources = new Set();
                (logs || []).forEach(log => {
                    const source = getProp(log, 'SourceContext') || getProp(log, 'CategoryName') || '';
                    if (source) {
                        uniqueSources.add(source);
                    }
                });
                
                // Update source filter combobox
                const sourceSelect = document.getElementById('log-source-filter');
                if (sourceSelect) {
                    const currentValue = sourceSelect.value;
                    const options = Array.from(uniqueSources).sort();
                    
                    // Keep "همه منابع" option and add unique sources
                    sourceSelect.innerHTML = '<option value="">همه منابع</option>';
                    options.forEach(source => {
                        const option = document.createElement('option');
                        option.value = source;
                        option.textContent = source;
                        sourceSelect.appendChild(option);
                    });
                    
                    // Restore previous selection if it still exists
                    if (currentValue && options.includes(currentValue)) {
                        sourceSelect.value = currentValue;
                    }
                }
                
                // Apply client-side text filter if needed (for cases where API doesn't support it)
                let filteredLogs = logs || [];
                if (textFilter && !url.includes('textSearch=')) {
                    const searchLower = textFilter.toLowerCase();
                    filteredLogs = filteredLogs.filter(log => {
                        const message = (getProp(log, 'Message') || '').toLowerCase();
                        const source = (getProp(log, 'SourceContext') || getProp(log, 'CategoryName') || '').toLowerCase();
                        const correlation = (getProp(log, 'CorrelationId') || getProp(log, 'CorrelationID') || '').toLowerCase();
                        return message.includes(searchLower) || source.includes(searchLower) || correlation.includes(searchLower);
                    });
                }
                
                // Apply client-side correlation ID filter if needed
                if (correlationId && !url.includes('correlationId=')) {
                    const correlationLower = correlationId.toLowerCase();
                    filteredLogs = filteredLogs.filter(log => {
                        const logCorrelation = (getProp(log, 'CorrelationId') || getProp(log, 'CorrelationID') || '').toLowerCase();
                        return logCorrelation.includes(correlationLower);
                    });
                }
                
                // Apply client-side source filter if needed
                if (sourceFilter && !url.includes('source=')) {
                    filteredLogs = filteredLogs.filter(log => {
                        const logSource = getProp(log, 'SourceContext') || getProp(log, 'CategoryName') || '';
                        return logSource === sourceFilter;
                    });
                }
                
                document.getElementById('logs-tab-badge').textContent = filteredLogs ? filteredLogs.length : 0;
                
                // Update filter status
                updateLogFilterStatus(sourceFilter, correlationId, textFilter, filteredLogs.length, logs ? logs.length : 0);
                
                if (!filteredLogs || filteredLogs.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 20px; color: #6b7280;">لاگی یافت نشد</td></tr>';
                    return;
                }
                
                tbody.innerHTML = filteredLogs.map(log => {
                    const timestamp = getProp(log, 'Timestamp');
                    const level = getProp(log, 'Level');
                    const source = getProp(log, 'SourceContext') || getProp(log, 'CategoryName') || '';
                    const message = getProp(log, 'Message') || '';
                    const correlationId = getProp(log, 'CorrelationId') || getProp(log, 'CorrelationID') || '';
                    return `
                    <tr>
                        <td class="log-time">${formatTime(timestamp)}</td>
                        <td>${getLogLevelBadge(level)}</td>
                        <td class="log-source" title="${source}">${source || '-'}</td>
                        <td class="log-correlation" style="font-family: monospace; font-size: 11px; color: #6b7280; direction: ltr; text-align: left;" title="${correlationId}">${correlationId || '-'}</td>
                        <td class="log-message" title="${message}">${message}</td>
                    </tr>
                `}).join('');
                
            } catch (error) {
                console.error('Error fetching logs:', error);
                document.getElementById('logs-body').innerHTML = 
                    '<tr><td colspan="5" style="text-align: center; padding: 20px; color: #ef4444;">خطا در بارگذاری لاگ‌ها</td></tr>';
            }
        }
        
        // Handle log filter changes
        window.handleLogFilterChange = function() {
            const activeLevel = document.querySelector('.log-filter-btn.active')?.dataset.level || 'all';
            fetchLogs(activeLevel);
        };
        
        // Clear log filters
        window.clearLogFilters = function() {
            document.getElementById('log-source-filter').value = '';
            document.getElementById('log-correlation-filter').value = '';
            document.getElementById('log-text-filter').value = '';
            const activeLevel = document.querySelector('.log-filter-btn.active')?.dataset.level || 'all';
            fetchLogs(activeLevel);
        };
        
        // Update log filter status
        function updateLogFilterStatus(sourceFilter, correlationId, textFilter, filteredCount, totalCount) {
            const statusEl = document.getElementById('log-filter-status');
            if (!statusEl) return;
            
            const filters = [];
            if (sourceFilter) filters.push('منبع: ' + sourceFilter);
            if (correlationId) filters.push('Correlation ID: ' + correlationId);
            if (textFilter) filters.push('متن: ' + textFilter);
            
            if (filters.length > 0) {
                statusEl.textContent = `فیلترها: ${filters.join(' | ')} | نمایش ${filteredCount} از ${totalCount} لاگ`;
                statusEl.style.color = '#0ea5e9';
            } else {
                statusEl.textContent = 'فیلترها اعمال نشده';
                statusEl.style.color = '#9ca3af';
            }
        }
        
        // Extract prefix from metric name (e.g., "System.Cpu" -> "System")
        function getMetricPrefix(name) {
            if (!name) return 'Other';
            const parts = name.split(/[._-]/);
            return parts.length > 1 ? parts[0] : 'Other';
        }
        
        // Fetch collected metrics
        async function fetchCollectedMetrics() {
            try {
                const response = await fetch(`${API_BASE}/metrics/all`);
                if (!response.ok) throw new Error('Failed to fetch: ' + response.status);
                const data = await response.json();
                
                const totalMetrics = getProp(data, 'TotalMetrics') || 0;
                const metrics = getProp(data, 'Metrics') || [];
                
                document.getElementById('metrics-tab-badge').textContent = totalMetrics;
                
                if (!metrics || metrics.length === 0) {
                    document.getElementById('collected-metrics-body').innerHTML = 
                        '<div style="text-align: center; padding: 20px; color: #6b7280;">متریکی جمع‌آوری نشده است</div>';
                    return;
                }
                
                // Store metric data for drill-down
                window.metricsData = window.metricsData || [];
                window.metricsData = [];
                
                // Group metrics by prefix
                const groupedMetrics = {};
                metrics.forEach(function(metric, index) {
                    window.metricsData[index] = metric;
                    const name = getProp(metric, 'Name') || '-';
                    const prefix = getMetricPrefix(name);
                    
                    if (!groupedMetrics[prefix]) {
                        groupedMetrics[prefix] = [];
                    }
                    groupedMetrics[prefix].push({ metric: metric, index: index });
                });
                
                // Sort prefixes alphabetically
                const sortedPrefixes = Object.keys(groupedMetrics).sort();
                
                // Sort metrics within each prefix group by name
                sortedPrefixes.forEach(function(prefix) {
                    groupedMetrics[prefix].sort(function(a, b) {
                        const nameA = getProp(a.metric, 'Name') || '';
                        const nameB = getProp(b.metric, 'Name') || '';
                        return nameA.localeCompare(nameB);
                    });
                });
                
                // Generate prefix tabs
                const tabsContainer = document.getElementById('metric-prefix-tabs');
                tabsContainer.innerHTML = sortedPrefixes.map(function(prefix, tabIndex) {
                    const count = groupedMetrics[prefix].length;
                    const isActive = tabIndex === 0 ? 'active' : '';
                    return '<button class="metric-prefix-tab ' + isActive + '" data-prefix="' + prefix + '" onclick="switchMetricPrefix(\'' + prefix + '\')">' +
                        '<span class="metric-prefix-tab-badge">' + count + '</span>' +
                        prefix +
                        '</button>';
                }).join('');
                
                // Generate metric tables for each prefix
                const metricsContainer = document.getElementById('collected-metrics-body');
                if (!metricsContainer) {
                    console.error('collected-metrics-body element not found');
                    return;
                }
                
                if (sortedPrefixes.length === 0) {
                    metricsContainer.innerHTML = '<div style="text-align: center; padding: 20px; color: #6b7280;">متریکی جمع‌آوری نشده است</div>';
                    return;
                }
                
                metricsContainer.innerHTML = sortedPrefixes.map(function(prefix, tabIndex) {
                    const isActive = tabIndex === 0 ? 'active' : '';
                    const prefixMetrics = groupedMetrics[prefix];
                    
                    const tableRows = prefixMetrics.map(function(item) {
                        const metric = item.metric;
                        const index = item.index;
                        const name = getProp(metric, 'Name') || '-';
                        const type = getProp(metric, 'Type') || '-';
                        const desc = getProp(metric, 'Description') || '-';
                        const unit = getProp(metric, 'Unit') || '';
                        const stats = getProp(metric, 'Stats');
                        const count = stats ? (getProp(stats, 'Count') || 0) : 0;
                        const current = stats ? (getProp(stats, 'CurrentValue') || 0) : 0;
                        const avg = stats ? (getProp(stats, 'AvgValue') || 0) : 0;
                        
                        return '<tr class="metric-row clickable" onclick="showMetricDrillDown(' + index + ')" title="کلیک برای جزئیات">' +
                            '<td class="metric-name">' + name + '</td>' +
                            '<td><span class="metric-type">' + type + '</span></td>' +
                            '<td class="metric-value">' + count.toLocaleString() + '</td>' +
                            '<td class="metric-value">' + (typeof current === 'number' ? current.toFixed(2) : current) + (unit ? ' ' + unit : '') + '</td>' +
                            '<td class="metric-value">' + (typeof avg === 'number' ? avg.toFixed(2) : avg) + (unit ? ' ' + unit : '') + '</td>' +
                            '<td style="font-size: 11px; color: #6b7280; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">' + (desc || '-') + '</td>' +
                        '</tr>';
                    }).join('');
                    
                    return '<div class="metrics-content ' + isActive + '" id="metrics-prefix-' + prefix + '">' +
                        '<table class="metrics-table-compact">' +
                        '<thead>' +
                        '<tr>' +
                        '<th style="width: 200px;">نام متریک</th>' +
                        '<th style="width: 80px;">نوع</th>' +
                        '<th style="width: 80px;">تعداد</th>' +
                        '<th style="width: 100px;">فعلی</th>' +
                        '<th style="width: 100px;">میانگین</th>' +
                        '<th>توضیحات</th>' +
                        '</tr>' +
                        '</thead>' +
                        '<tbody>' +
                        tableRows +
                        '</tbody>' +
                        '</table>' +
                        '</div>';
                }).join('');
                
                // Ensure first tab is visible after rendering
                setTimeout(function() {
                    const firstContent = document.querySelector('.metrics-content.active');
                    if (firstContent) {
                        firstContent.style.display = 'block';
                    }
                }, 100);
                
            } catch (error) {
                console.error('Error fetching collected metrics:', error);
                document.getElementById('collected-metrics-body').innerHTML = 
                    '<div style="text-align: center; padding: 20px; color: #ef4444;">خطا در بارگذاری متریک‌ها</div>';
            }
        }
        
        // Switch metric prefix tab
        window.switchMetricPrefix = function(prefix) {
            // Update tab buttons
            document.querySelectorAll('.metric-prefix-tab').forEach(function(tab) {
                if (tab.dataset.prefix === prefix) {
                    tab.classList.add('active');
                } else {
                    tab.classList.remove('active');
                }
            });
            
            // Update content visibility
            document.querySelectorAll('.metrics-content').forEach(function(content) {
                if (content.id === 'metrics-prefix-' + prefix) {
                    content.classList.add('active');
                    content.style.display = 'block';
                } else {
                    content.classList.remove('active');
                    content.style.display = 'none';
                }
            });
        };
        
        // Service colors for Jaeger-like display
        const serviceColors = {};
        let colorIndex = 0;
        const colorClasses = ['service-color-1', 'service-color-2', 'service-color-3', 'service-color-4', 'service-color-5', 'service-color-6'];
        
        function getServiceColor(serviceName) {
            if (!serviceColors[serviceName]) {
                serviceColors[serviceName] = colorClasses[colorIndex % colorClasses.length];
                colorIndex++;
            }
            return serviceColors[serviceName];
        }
        
        // Get span kind class
        function getSpanKindClass(kind) {
            const kinds = { 0: 'internal', 1: 'server', 2: 'client', 3: 'producer', 4: 'consumer' };
            return kinds[kind] || 'internal';
        }
        
        // Get status class
        function getStatusClass(status) {
            const statuses = { 0: 'unset', 1: 'ok', 2: 'error' };
            return statuses[status] || 'unset';
        }
        
        // Get status text
        function getStatusText(status) {
            const texts = { 0: 'نامشخص', 1: 'موفق', 2: 'خطا' };
            return texts[status] || 'نامشخص';
        }
        
        // Render trace timeline (Jaeger-style)
        function renderTraceTimeline(trace) {
            const spans = getProp(trace, 'Spans') || [];
            if (spans.length === 0) return '<div class="no-traces">اسپنی یافت نشد</div>';
            
            const traceStart = new Date(getProp(trace, 'StartTime')).getTime();
            const traceEnd = new Date(getProp(trace, 'EndTime')).getTime();
            const totalDuration = traceEnd - traceStart;
            
            if (totalDuration <= 0) return '<div class="no-traces">مدت زمان نامعتبر</div>';
            
            // Build tree structure from spans
            const spanMap = new Map();
            const rootSpans = [];
            
            // First pass: index all spans by SpanId
            spans.forEach(span => {
                const spanId = getProp(span, 'SpanId');
                spanMap.set(spanId, { ...span, children: [] });
            });
            
            // Second pass: build parent-child relationships
            spans.forEach(span => {
                const spanId = getProp(span, 'SpanId');
                const parentId = getProp(span, 'ParentSpanId');
                const spanNode = spanMap.get(spanId);
                
                if (parentId && spanMap.has(parentId)) {
                    spanMap.get(parentId).children.push(spanNode);
                } else {
                    rootSpans.push(spanNode);
                }
            });
            
            // Sort roots and children by start time
            const sortByStartTime = (a, b) => 
                new Date(getProp(a, 'StartTime')).getTime() - new Date(getProp(b, 'StartTime')).getTime();
            rootSpans.sort(sortByStartTime);
            spanMap.forEach(span => span.children.sort(sortByStartTime));
            
            // Scale marks
            const scaleMarks = [0, 0.25, 0.5, 0.75, 1].map(pct => formatDuration(totalDuration * pct));
            
            let html = '<div class="timeline-header">';
            html += '<div class="timeline-info">';
            html += '<span style="color: #6b7280; font-size: 12px;">';
            html += '<strong>زنجیره‌ها:</strong> ' + rootSpans.length + ' | ';
            html += '<strong>کل Spans:</strong> ' + spans.length;
            html += '</span>';
            html += '</div>';
            html += '<div class="timeline-scale">';
            scaleMarks.forEach(mark => { html += '<span>' + mark + '</span>'; });
            html += '</div></div>';
            
            // Render span recursively with depth
            function renderSpanRow(span, depth) {
                const spanStart = new Date(getProp(span, 'StartTime')).getTime();
                const spanEnd = new Date(getProp(span, 'EndTime')).getTime();
                const spanDuration = spanEnd - spanStart;
                
                const leftPct = ((spanStart - traceStart) / totalDuration * 100).toFixed(2);
                const widthPct = Math.max(0.5, (spanDuration / totalDuration * 100)).toFixed(2);
                
                const serviceName = getProp(span, 'ServiceName') || 'unknown';
                const operationName = getProp(span, 'OperationName') || '-';
                const kind = getProp(span, 'Kind') || 0;
                const status = getProp(span, 'Status') || 0;
                const statusMessage = getProp(span, 'StatusMessage') || '';
                const tags = getProp(span, 'Tags') || {};
                const events = getProp(span, 'Events') || [];
                const children = span.children || [];
                const hasChildren = children.length > 0;
                const hasError = status === 2;
                const hasDetails = hasError || Object.keys(tags).length > 0 || events.length > 0;
                const spanId = getProp(span, 'SpanId') || '';
                
                const kindClass = hasError ? 'error' : getSpanKindClass(kind);
                const indentPx = depth * 20;
                
                let rowHtml = '<div class="span-row depth-' + depth + '" data-depth="' + depth + '" data-span-id="' + spanId + '">';
                
                // Tree indicator
                rowHtml += '<div class="span-tree-indicator" style="width: ' + (indentPx + 16) + 'px;">';
                if (depth > 0) {
                    rowHtml += '<span class="tree-line" style="right: ' + indentPx + 'px;"></span>';
                    rowHtml += '<span class="tree-branch" style="right: ' + (indentPx - 8) + 'px;"></span>';
                }
                if (hasChildren) {
                    rowHtml += '<span class="tree-expand">▼</span>';
                }
                rowHtml += '</div>';
                
                rowHtml += '<div class="span-service" style="margin-right: ' + indentPx + 'px;">';
                rowHtml += '<span class="span-service-dot ' + getServiceColor(serviceName) + '"></span>';
                rowHtml += serviceName + '</div>';
                rowHtml += '<div class="span-operation-name" title="' + operationName + '">' + operationName + '</div>';
                rowHtml += '<div class="span-timeline-container">';
                rowHtml += '<div class="span-bar ' + kindClass + '" style="left: ' + leftPct + '%; width: ' + widthPct + '%;">';
                if (parseFloat(widthPct) > 5) {
                    rowHtml += '<span class="span-duration-label">' + formatDuration(spanDuration) + '</span>';
                }
                rowHtml += '</div>';
                rowHtml += '</div>';
                rowHtml += '<div class="span-duration-text">' + formatDuration(spanDuration) + '</div>';
                
                // Add expand button for spans with details
                if (hasDetails) {
                    rowHtml += '<div class="span-details-toggle" onclick="toggleSpanDetails(\'' + spanId + '\')" title="نمایش جزئیات">';
                    rowHtml += hasError ? '⚠️' : 'ℹ️';
                    rowHtml += '</div>';
                }
                
                rowHtml += '</div>';
                
                // Add details section (initially hidden)
                if (hasDetails) {
                    rowHtml += '<div class="span-details" id="span-details-' + spanId + '" style="display: none;">';
                    
                    // Error message
                    if (hasError && statusMessage) {
                        rowHtml += '<div style="background: #fee2e2; border-right: 3px solid #ef4444; padding: 8px 12px; margin-bottom: 8px; border-radius: 4px;">';
                        rowHtml += '<strong style="color: #dc2626;">خطا:</strong> ';
                        rowHtml += '<span style="color: #991b1b; font-family: monospace;">' + escapeHtml(statusMessage) + '</span>';
                        rowHtml += '</div>';
                    }
                    
                    // Tags
                    if (Object.keys(tags).length > 0) {
                        rowHtml += '<div style="margin-bottom: 8px;">';
                        rowHtml += '<strong style="color: #6b7280; font-size: 11px; display: block; margin-bottom: 4px;">برچسب‌ها:</strong>';
                        rowHtml += '<div class="span-tags">';
                        for (const [key, value] of Object.entries(tags)) {
                            rowHtml += '<div class="span-tag">';
                            rowHtml += '<span class="span-tag-key">' + escapeHtml(key) + ':</span> ';
                            rowHtml += '<span class="span-tag-value">' + escapeHtml(String(value)) + '</span>';
                            rowHtml += '</div>';
                        }
                        rowHtml += '</div>';
                        rowHtml += '</div>';
                    }
                    
                    // Events
                    if (events.length > 0) {
                        rowHtml += '<div>';
                        rowHtml += '<strong style="color: #6b7280; font-size: 11px; display: block; margin-bottom: 4px;">رویدادها (' + events.length + '):</strong>';
                        events.forEach((event, idx) => {
                            const eventName = getProp(event, 'Name') || 'Unknown';
                            const eventAttrs = getProp(event, 'Attributes') || {};
                            rowHtml += '<div style="background: white; border: 1px solid #e5e7eb; padding: 6px 8px; margin-bottom: 4px; border-radius: 4px; font-size: 11px;">';
                            rowHtml += '<strong>' + escapeHtml(eventName) + '</strong>';
                            if (Object.keys(eventAttrs).length > 0) {
                                rowHtml += '<div style="margin-top: 4px; padding-top: 4px; border-top: 1px solid #f3f4f6;">';
                                for (const [key, value] of Object.entries(eventAttrs)) {
                                    rowHtml += '<span style="color: #6b7280; margin-left: 8px;">' + escapeHtml(key) + ': <strong>' + escapeHtml(String(value)) + '</strong></span>';
                                }
                                rowHtml += '</div>';
                            }
                            rowHtml += '</div>';
                        });
                        rowHtml += '</div>';
                    }
                    
                    rowHtml += '</div>';
                }
                
                // Render children
                children.forEach(child => {
                    rowHtml += renderSpanRow(child, depth + 1);
                });
                
                return rowHtml;
            }
            
            // Render all root spans
            rootSpans.forEach(span => {
                html += renderSpanRow(span, 0);
            });
            
            return html;
        }
        
        // Fetch traces
        async function fetchTraces() {
            try {
                // Get filter values
                const timeFilter = document.getElementById('trace-time-filter')?.value || '5';
                const serviceFilter = document.getElementById('trace-service-filter')?.value || '';
                const kindFilter = document.getElementById('trace-kind-filter')?.value || '';
                const statusFilter = document.getElementById('trace-status-filter')?.value || '';
                const durationFilter = document.getElementById('trace-duration-filter')?.value || '';
                
                // Build URL with filters
                let url = `${API_BASE}/traces/recent?limit=50`;
                if (timeFilter && timeFilter !== '0') {
                    const minutes = parseInt(timeFilter);
                    const fromTime = new Date(Date.now() - minutes * 60 * 1000).toISOString();
                    url += `&from=${encodeURIComponent(fromTime)}`;
                }
                if (serviceFilter) {
                    url += `&serviceName=${encodeURIComponent(serviceFilter)}`;
                }
                if (kindFilter !== '') {
                    url += `&kind=${kindFilter}`;
                }
                if (statusFilter !== '') {
                    url += `&status=${statusFilter}`;
                }
                
                const response = await fetch(url);
                if (!response.ok) throw new Error('Failed to fetch: ' + response.status);
                const traces = await response.json();
                
                // Extract unique services and populate combobox
                const uniqueServices = new Set();
                (traces || []).forEach(trace => {
                    const serviceName = getProp(trace, 'ServiceName') || '';
                    if (serviceName) {
                        uniqueServices.add(serviceName);
                    }
                });
                
                // Update service filter combobox
                const serviceSelect = document.getElementById('trace-service-filter');
                if (serviceSelect) {
                    const currentValue = serviceSelect.value;
                    const options = Array.from(uniqueServices).sort();
                    
                    // Keep "همه سرویس‌ها" option and add unique services
                    serviceSelect.innerHTML = '<option value="">همه سرویس‌ها</option>';
                    options.forEach(service => {
                        const option = document.createElement('option');
                        option.value = service;
                        option.textContent = service;
                        serviceSelect.appendChild(option);
                    });
                    
                    // Restore previous selection if it still exists
                    if (currentValue && options.includes(currentValue)) {
                        serviceSelect.value = currentValue;
                    }
                }
                
                // Apply client-side filters
                // Note: We apply filters client-side to ensure they work even if API doesn't support them
                let filteredTraces = traces || [];
                
                // Filter by service (client-side)
                if (serviceFilter) {
                    filteredTraces = filteredTraces.filter(trace => {
                        const serviceName = getProp(trace, 'ServiceName') || '';
                        return serviceName === serviceFilter;
                    });
                }
                
                // Filter by kind (client-side)
                if (kindFilter !== '') {
                    const kindValue = parseInt(kindFilter);
                    filteredTraces = filteredTraces.filter(trace => {
                        const spans = getProp(trace, 'Spans') || [];
                        return spans.some(span => {
                            const spanKind = getProp(span, 'Kind') || 0;
                            return spanKind === kindValue;
                        });
                    });
                }
                
                // Filter by status (client-side)
                if (statusFilter !== '') {
                    const statusValue = parseInt(statusFilter);
                    filteredTraces = filteredTraces.filter(trace => {
                        const traceStatus = getProp(trace, 'Status') || 0;
                        return traceStatus === statusValue;
                    });
                }
                
                // Filter by time (client-side)
                if (timeFilter && timeFilter !== '0') {
                    const minutes = parseInt(timeFilter);
                    const cutoffTime = Date.now() - minutes * 60 * 1000;
                    filteredTraces = filteredTraces.filter(trace => {
                        const startTimeStr = getProp(trace, 'StartTime');
                        if (!startTimeStr) {
                            return false; // Skip traces without start time
                        }
                        const startTime = new Date(startTimeStr).getTime();
                        if (isNaN(startTime)) {
                            return false; // Skip traces with invalid date
                        }
                        return startTime >= cutoffTime;
                    });
                }
                
                // Filter by duration (client-side)
                if (durationFilter) {
                    filteredTraces = filteredTraces.filter(trace => {
                        const startTimeStr = getProp(trace, 'StartTime');
                        const endTimeStr = getProp(trace, 'EndTime');
                        
                        if (!startTimeStr || !endTimeStr) {
                            return false; // Skip traces without valid times
                        }
                        
                        const startTime = new Date(startTimeStr).getTime();
                        const endTime = new Date(endTimeStr).getTime();
                        
                        if (isNaN(startTime) || isNaN(endTime)) {
                            return false; // Skip traces with invalid dates
                        }
                        
                        const duration = endTime - startTime; // duration in milliseconds
                        
                        if (duration < 0) {
                            return false; // Skip traces with negative duration
                        }
                        
                        switch (durationFilter) {
                            case 'lt10':
                                return duration < 10;
                            case 'lt50':
                                return duration < 50;
                            case 'lt100':
                                return duration < 100;
                            case 'lt500':
                                return duration < 500;
                            case 'lt1000':
                                return duration < 1000;
                            case 'gte1000':
                                return duration >= 1000;
                            case 'range50-100':
                                return duration >= 50 && duration < 100;
                            case 'range100-500':
                                return duration >= 100 && duration < 500;
                            case 'range500-1000':
                                return duration >= 500 && duration < 1000;
                            default:
                                return true;
                        }
                    });
                }
                
                // Update filter status
                updateTraceFilterStatus(timeFilter, serviceFilter, kindFilter, statusFilter, durationFilter, filteredTraces.length, traces ? traces.length : 0);
                
                // Also fetch stats
                const statsResponse = await fetch(`${API_BASE}/traces/stats`);
                if (statsResponse.ok) {
                    const stats = await statsResponse.json();
                    const totalTraces = getProp(stats, 'TotalTraces') || 0;
                    document.getElementById('trace-total').textContent = totalTraces;
                    document.getElementById('trace-errors').textContent = getProp(stats, 'ErrorTraces') || 0;
                    document.getElementById('trace-avg').textContent = formatDuration(getProp(stats, 'AvgDurationMs') || 0);
                    document.getElementById('traces-tab-badge').textContent = filteredTraces.length;
                }
                
                const container = document.getElementById('traces-container');
                if (!filteredTraces || filteredTraces.length === 0) {
                    container.innerHTML = '<div class="no-traces">ردیابی‌ای یافت نشد</div>';
                    return;
                }
                
                let html = '';
                filteredTraces.forEach((trace, index) => {
                    const traceId = getProp(trace, 'TraceId') || '-';
                    const serviceName = getProp(trace, 'ServiceName') || 'unknown';
                    const rootOperation = getProp(trace, 'RootOperationName') || '-';
                    const startTime = getProp(trace, 'StartTime');
                    const duration = (new Date(getProp(trace, 'EndTime')) - new Date(startTime));
                    const status = getProp(trace, 'Status') || 0;
                    const spanCount = getProp(trace, 'SpanCount') || 0;
                    const errorCount = getProp(trace, 'ErrorCount') || 0;
                    
                    const colorClass = getServiceColor(serviceName);
                    const statusClass = getStatusClass(status);
                    const statusText = getStatusText(status);
                    
                    html += '<div class="trace-item" data-trace-index="' + index + '">';
                    html += '<div class="trace-item-header" onclick="toggleTrace(' + index + ')">';
                    html += '<div class="trace-service">';
                    html += '<span class="trace-service-dot ' + colorClass + '"></span>';
                    html += '<span class="trace-service-name">' + serviceName + '</span>';
                    html += '</div>';
                    html += '<div class="trace-operation">' + rootOperation + '</div>';
                    html += '<div class="trace-meta">';
                    html += '<span class="trace-span-count"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg> ' + spanCount + '</span>';
                    if (errorCount > 0) {
                        html += '<span style="color: #ef4444;">' + errorCount + ' خطا</span>';
                    }
                    html += '<span class="trace-duration">' + formatDuration(duration) + '</span>';
                    html += '<span class="trace-status ' + statusClass + '">' + statusText + '</span>';
                    html += '<span class="trace-time">' + formatTime(startTime) + '</span>';
                    html += '</div>';
                    html += '</div>';
                    html += '<div class="trace-timeline" id="trace-timeline-' + index + '">';
                    html += renderTraceTimeline(trace);
                    html += '</div>';
                    html += '</div>';
                });
                
                container.innerHTML = html;
                
            } catch (error) {
                console.error('Error fetching traces:', error);
                document.getElementById('traces-container').innerHTML = 
                    '<div class="no-traces" style="color: #ef4444;">خطا در بارگذاری ردیابی‌ها</div>';
            }
        }
        
        // Toggle trace expand/collapse
        window.toggleTrace = function(index) {
            const traceItem = document.querySelector('[data-trace-index="' + index + '"]');
            if (traceItem) {
                traceItem.classList.toggle('expanded');
            }
        };
        
        // Toggle span details
        window.toggleSpanDetails = function(spanId) {
            const detailsEl = document.getElementById('span-details-' + spanId);
            if (detailsEl) {
                detailsEl.style.display = detailsEl.style.display === 'none' ? 'block' : 'none';
            }
        };
        
        // Escape HTML to prevent XSS
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Handle trace filter changes
        window.handleTraceFilterChange = function() {
            fetchTraces();
        };
        
        // Clear trace filters
        window.clearTraceFilters = function() {
            document.getElementById('trace-time-filter').value = '5';
            document.getElementById('trace-service-filter').value = '';
            document.getElementById('trace-kind-filter').value = '';
            document.getElementById('trace-status-filter').value = '';
            document.getElementById('trace-duration-filter').value = '';
            fetchTraces();
        };
        
        // Update trace filter status
        function updateTraceFilterStatus(timeFilter, serviceFilter, kindFilter, statusFilter, durationFilter, filteredCount, totalCount) {
            const statusEl = document.getElementById('trace-filter-status');
            if (!statusEl) return;
            
            const filters = [];
            if (timeFilter && timeFilter !== '0') {
                const timeLabels = { '5': '5 دقیقه', '15': '15 دقیقه', '30': '30 دقیقه', '60': '1 ساعت', '1440': '24 ساعت' };
                filters.push('زمان: ' + (timeLabels[timeFilter] || timeFilter + ' دقیقه'));
            }
            if (serviceFilter) filters.push('سرویس: ' + serviceFilter);
            if (kindFilter !== '') {
                const kindLabels = { '0': 'Internal', '1': 'Server', '2': 'Client', '3': 'Producer', '4': 'Consumer' };
                filters.push('نوع: ' + (kindLabels[kindFilter] || kindFilter));
            }
            if (statusFilter !== '') {
                const statusLabels = { '0': 'نامشخص', '1': 'موفق', '2': 'خطا' };
                filters.push('وضعیت: ' + (statusLabels[statusFilter] || statusFilter));
            }
            if (durationFilter) {
                const durationLabels = {
                    'lt10': 'کمتر از 10ms',
                    'lt50': 'کمتر از 50ms',
                    'lt100': 'کمتر از 100ms',
                    'lt500': 'کمتر از 500ms',
                    'lt1000': 'کمتر از 1s',
                    'gte1000': 'بیشتر از 1s',
                    'range50-100': 'بین 50ms تا 100ms',
                    'range100-500': 'بین 100ms تا 500ms',
                    'range500-1000': 'بین 500ms تا 1s'
                };
                filters.push('زمان اجرا: ' + (durationLabels[durationFilter] || durationFilter));
            }
            
            if (filters.length > 0) {
                statusEl.textContent = `فیلترها: ${filters.join(' | ')} | نمایش ${filteredCount} از ${totalCount} ردیابی`;
                statusEl.style.color = '#0ea5e9';
            } else {
                statusEl.textContent = 'فیلترها اعمال نشده';
                statusEl.style.color = '#9ca3af';
            }
        }
        
        // Initialize
        function init() {
            // Fetch initial data
            fetchDashboard();
            fetchHealth();
            fetchLogs(currentLogLevel);
            fetchCollectedMetrics();
            fetchTraces();
            fetchChartsData();
            
            // Set up auto-refresh
            setInterval(() => {
                if (!isPaused) {
                    fetchChartsData();
                    fetchDashboard();
                    fetchHealth();
                }
            }, 3000);
            
            setInterval(() => {
                if (!isPaused) {
                    fetchLogs(currentLogLevel);
                    fetchCollectedMetrics();
                    fetchTraces();
                }
            }, 5000);
            
            // Set up log filter buttons
            document.querySelectorAll('.log-filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.log-filter-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentLogLevel = this.dataset.level;
                    fetchLogs(currentLogLevel);
                });
            });
            
            // Set up Enter key for filter inputs
            document.getElementById('log-correlation-filter')?.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    handleLogFilterChange();
                }
            });
            
            document.getElementById('log-text-filter')?.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    handleLogFilterChange();
                }
            });
        }
        
        // Start when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
    
    // حذف فایل‌های layout.min.js و BrowserLink که ممکن است از static files لود شده باشند
    (function() {
        // تابع برای هاید کردن menu2 و overlay/backdrop Mmenu
        function hideMenu2() {
            // هاید کردن menu2 با روش‌های مختلف
            var menu2 = document.getElementById('menu2');

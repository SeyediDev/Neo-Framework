@{
    ViewData["Title"] = "ورود به مانیتورینگ";
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string ?? "/Monitoring";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            direction: rtl;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .login-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            padding: 40px;
            width: 100%;
            max-width: 420px;
        }
        
        .login-header {
            text-align: center;
            margin-bottom: 32px;
        }
        
        .login-header h1 {
            color: #1f2937;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        
        .login-header p {
            color: #6b7280;
            font-size: 14px;
        }
        
        .form-group {
            margin-bottom: 24px;
        }
        
        .form-group label {
            display: block;
            color: #374151;
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 8px;
        }
        
        .form-group input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.2s;
            direction: ltr;
            text-align: left;
        }
        
        .form-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .form-group input.error {
            border-color: #ef4444;
        }
        
        .error-message {
            color: #ef4444;
            font-size: 12px;
            margin-top: 6px;
            display: none;
        }
        
        .error-message.show {
            display: block;
        }
        
        .btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 8px;
        }
        
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }
        
        .btn-login:active {
            transform: translateY(0);
        }
        
        .btn-login:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        
        .info-box {
            background: #f3f4f6;
            border-radius: 8px;
            padding: 16px;
            margin-top: 24px;
            font-size: 13px;
            color: #6b7280;
            line-height: 1.6;
        }
        
        .info-box strong {
            color: #374151;
        }
        
        .loading {
            display: none;
            text-align: center;
            margin-top: 16px;
        }
        
        .loading.show {
            display: block;
        }
        
        .spinner {
            border: 3px solid #f3f4f6;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>🔐 ورود به مانیتورینگ</h1>
            <p>لطفاً اطلاعات احراز هویت خود را وارد کنید</p>
        </div>
        
        <form id="loginForm" onsubmit="handleLogin(event)">
            <div class="form-group">
                <label for="clientId">شناسه کلاینت (Client ID)</label>
                <input type="text" id="clientId" name="clientId" required autocomplete="username" />
                <div class="error-message" id="clientIdError"></div>
            </div>
            
            <div class="form-group">
                <label for="clientSecret">رمز کلاینت (Client Secret)</label>
                <input type="password" id="clientSecret" name="clientSecret" required autocomplete="current-password" />
                <div class="error-message" id="clientSecretError"></div>
            </div>
            
            <button type="submit" class="btn-login" id="loginBtn">
                ورود
            </button>
            
            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p style="margin-top: 12px; color: #6b7280;">در حال ورود...</p>
            </div>
            
            <div class="error-message" id="generalError" style="text-align: center; margin-top: 16px;"></div>
        </form>
        
        <div class="info-box">
            <strong>نکته:</strong> برای دسترسی به مانیتورینگ، باید از Client Credentials Flow استفاده کنید.
            <br><br>
            <strong>برای Development (MemoryIdpService):</strong><br>
            Client ID: <code>monitoring-client</code><br>
            Client Secret: <code>monitoring-secret</code><br>
            <br>
            یا می‌توانید از:<br>
            Client ID: <code>bajet-client</code><br>
            Client Secret: <code>bajet-secret</code><br>
            <br>
            <strong>برای Production (Keycloak):</strong><br>
            شناسه و رمز کلاینت را از مدیر سیستم دریافت کنید.
        </div>
    </div>
    
    <script>
        const returnUrl = '@returnUrl';
        
        async function handleLogin(event) {
            event.preventDefault();
            
            const clientId = document.getElementById('clientId').value.trim();
            const clientSecret = document.getElementById('clientSecret').value.trim();
            const loginBtn = document.getElementById('loginBtn');
            const loading = document.getElementById('loading');
            const generalError = document.getElementById('generalError');
            
            // Reset errors
            generalError.textContent = '';
            generalError.classList.remove('show');
            document.getElementById('clientId').classList.remove('error');
            document.getElementById('clientSecret').classList.remove('error');
            
            // Validate
            if (!clientId || !clientSecret) {
                generalError.textContent = 'لطفاً تمام فیلدها را پر کنید';
                generalError.classList.add('show');
                return;
            }
            
            // Show loading
            loginBtn.disabled = true;
            loading.classList.add('show');
            
            try {
                // Get API version from URL or use default
                const apiVersion = 'v1'; // You can make this dynamic if needed
                const tokenUrl = `/api/${apiVersion}/auth/token`;
                
                // Prepare form data
                const formData = new URLSearchParams();
                formData.append('grant_type', 'client_credentials');
                formData.append('client_id', clientId);
                formData.append('client_secret', clientSecret);
                
                // Request token
                const response = await fetch(tokenUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: formData.toString()
                });
                
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || 'خطا در احراز هویت');
                }
                
                const tokenData = await response.json();
                
                if (!tokenData.access_token) {
                    throw new Error('توکن دریافت نشد');
                }
                
                // Store token in localStorage (for API calls)
                localStorage.setItem('monitoring_token', tokenData.access_token);
                localStorage.setItem('monitoring_token_expires', Date.now() + (tokenData.expires_in * 1000));
                
                // Redirect to monitoring page
                window.location.href = returnUrl;
                
            } catch (error) {
                console.error('Login error:', error);
                generalError.textContent = 'خطا در احراز هویت: ' + (error.message || 'لطفاً دوباره تلاش کنید');
                generalError.classList.add('show');
                document.getElementById('clientId').classList.add('error');
                document.getElementById('clientSecret').classList.add('error');
            } finally {
                loginBtn.disabled = false;
                loading.classList.remove('show');
            }
        }
        
        // Check if already authenticated
        window.addEventListener('DOMContentLoaded', function() {
            const token = localStorage.getItem('monitoring_token');
            const expires = localStorage.getItem('monitoring_token_expires');
            
            if (token && expires && Date.now() < parseInt(expires)) {
                // Token exists and is valid, redirect to monitoring
                window.location.href = returnUrl;
            }
        });
    </script>
</body>
</html>


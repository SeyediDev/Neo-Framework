[Unit]
Description=Neo Agent Orchestration Web (%i)
After=network-online.target neo-agent-orchestration-api@%i.service
Wants=network-online.target

[Service]
User=neo-orch
Group=neo-orch
WorkingDirectory=/opt/neo-agent-orchestration/%i/current/web
EnvironmentFile=/etc/neo-agent-orchestration/%i.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
ExecStart=/usr/bin/dotnet /opt/neo-agent-orchestration/%i/current/web/Neo.AgentOrchestration.Web.dll --urls=http://127.0.0.1:${NEO_WEB_PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

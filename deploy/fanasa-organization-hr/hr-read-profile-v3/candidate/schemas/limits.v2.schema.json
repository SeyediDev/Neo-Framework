{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fanasa:contract-policy:limits:2.0.0",
  "title": "Fanasa allocation limits v2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allocationId",
    "scope",
    "canonicalScope",
    "meter",
    "unit",
    "rate",
    "quota",
    "configRevision"
  ],
  "properties": {
    "allocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "canonicalScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 13000
    },
    "meter": {
      "const": "api.request.admitted"
    },
    "unit": {
      "const": "request"
    },
    "rate": {
      "$ref": "#/$defs/rate"
    },
    "quota": {
      "$ref": "#/$defs/quota"
    },
    "configRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Independent authoritative allocation configuration revision. Never derived from policyVersion or contractVersion."
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerTenantId",
        "productIds",
        "environments",
        "operationGroups"
      ],
      "properties": {
        "consumerTenantId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9.-]{0,63}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
        },
        "productIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "operationGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "requestsPerSecond",
        "burstCapacity"
      ],
      "properties": {
        "algorithm": {
          "const": "token-bucket"
        },
        "requestsPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "burstCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "period",
        "requests"
      ],
      "properties": {
        "algorithm": {
          "const": "fixed-calendar-utc"
        },
        "period": {
          "const": "month"
        },
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}

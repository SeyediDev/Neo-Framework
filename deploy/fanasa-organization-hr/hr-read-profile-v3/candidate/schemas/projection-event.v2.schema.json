{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fanasa:contract-policy:projection-event:2.0.0",
  "title": "Normalized projection event (not the business contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "producer",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "projection"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "producer": {
      "const": "fanasa-contracts"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "projection": {
      "$ref": "contract-access-projection.v2.schema.json"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fanasa:contract-policy:projection:3.0.0",
  "title": "HR read candidate contract-access-projection v3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "contractId",
    "contractVersion",
    "ownerTenantId",
    "ownership",
    "consumerTenantId",
    "productId",
    "offerId",
    "subscriptionId",
    "status",
    "validFrom",
    "validTo",
    "effectiveAt",
    "featureEntitlements",
    "eligibleRoles",
    "seats",
    "limits",
    "zoneConstraints",
    "pricingReference",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0.0"
    },
    "profileId": {
      "const": "fanasa.organization-hr-read/1"
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ownerTenantId": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        { "type": "null" }
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "kind", "owner", "registeredProductId" ],
      "properties": {
        "kind": { "enum": [ "Platform", "Tenant" ] },
        "owner": { "type": "string", "minLength": 1, "maxLength": 64 },
        "registeredProductId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      }
    },
    "consumerTenantId": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9.-]{0,63}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
    },
    "productId": {
      "const": "organization-fabric"
    },
    "offerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "subscriptionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "status": {
      "enum": [
        "Active",
        "Suspended",
        "Ended"
      ]
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validTo": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "featureEntitlements": {
      "type": "array",
      "items": {
        "enum": [
          "organization.hr.chart.read",
          "organization.hr.history.read"
        ]
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "eligibleRoles": {
      "type": "array",
      "items": {
        "const": "HrReader"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "seats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum",
        "unit",
        "scope"
      ],
      "properties": {
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unit": {
          "const": "active-membership"
        },
        "scope": {
          "const": "consumer-product-subscription"
        }
      }
    },
    "limits": {
      "$ref": "limits.v2.schema.json"
    },
    "zoneConstraints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "pricingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priceId",
        "priceVersion"
      ],
      "properties": {
        "priceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,63}$"
        },
        "priceVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyVersion",
        "templateId",
        "combiningAlgorithm",
        "explicitDenyActions"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,63}$"
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "templateId": {
          "const": "organization-hr-read/1"
        },
        "combiningAlgorithm": {
          "const": "deny-overrides"
        },
        "explicitDenyActions": {
          "type": "array",
          "items": {
            "enum": [
              "organization.hr.chart.read",
              "organization.hr.history.read"
            ]
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    }
  }
}

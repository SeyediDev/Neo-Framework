<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Legacy fixtures use known non-null owner tenants. Keep their source
         unchanged while the DTO now supports nullable platform ownership. -->
    <WarningsNotAsErrors>CS8601</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fanasa.ContractPolicy/Fanasa.ContractPolicy.csproj" />
    <None Include="../../fixtures/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
